---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Page introuvable — Fedora" description="Cette page n'existe pas ou a été déplacée.">
  <section class="hero">
    <Nav />
    <div class="container body">
      <div class="code">404</div>
      <h1>Cette page a changé de terrain<span class="dot">.</span></h1>
      <p class="sub">La page que vous cherchez n'existe pas ou a été déplacée. Revenons sur le bon parcours.</p>
      <div class="ctas">
        <a class="btn-primary" href="/">Retour à l'accueil</a>
        <a class="btn-ghost" href="/produit">Explorer la plateforme</a>
      </div>
      <div class="links">
        <a href="/solutions">Solutions</a><span>·</span>
        <a href="/tarifs">Tarifs</a><span>·</span>
        <a href="/contact">Contact</a>
      </div>
    </div>
  </section>
  <Footer />
</Layout>

<style>
  .container { max-width: var(--maxw); margin: 0 auto; padding: 0 40px; }
  .hero { position: relative; background: var(--navy); color: #fff; padding: 0 0 100px; overflow: hidden; }
  .hero::before { content: ""; position: absolute; inset: 0; background-image: radial-gradient(rgba(255,255,255,.05) 1px, transparent 1px); background-size: 24px 24px; opacity: .7; }
  .hero::after { content: ""; position: absolute; width: 760px; height: 760px; right: -200px; top: -300px; background: radial-gradient(circle, rgba(240,122,32,.18), transparent 62%); }
  .body { position: relative; z-index: 1; padding-top: 80px; text-align: center; max-width: 640px; }
  .container.body { margin: 0 auto; }
  .code { font-family: "JetBrains Mono", monospace; font-weight: 700; font-size: 17px; letter-spacing: .3em; color: var(--orange); margin-bottom: 20px; }
  h1 { font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 48px; line-height: 1.05; letter-spacing: -.02em; margin: 0 0 16px; }
  h1 .dot { color: var(--orange); }
  .sub { font-size: 21px; line-height: 1.58; color: #aeb8c7; margin: 0 auto 30px; max-width: 520px; }
  .ctas { display: flex; gap: 14px; justify-content: center; }
  .btn-primary { display: inline-block; background: var(--orange); color: #fff; font-weight: 600; font-size: 17px; padding: 15px 26px; border-radius: 12px; text-decoration: none; }
  .btn-ghost { display: inline-block; border: 1px solid rgba(255,255,255,.3); color: #fff; font-weight: 600; font-size: 17px; padding: 15px 24px; border-radius: 12px; text-decoration: none; }
  .links { margin-top: 36px; display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; font-size: 16px; }
  .links a { color: #c7d2e0; text-decoration: none; }
  .links a:hover { color: #fff; }
  .links span { color: #45566f; }

  @media (max-width: 620px) {
    .container { padding: 0 20px; }
    .body { padding-top: 48px; }
    h1 { font-size: 35px; }
    .sub { font-size: 21px; }
    .ctas { flex-direction: column; align-items: stretch; }
    .btn-primary, .btn-ghost { text-align: center; }
  }
</style>
