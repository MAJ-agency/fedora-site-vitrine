---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const socleFeatures = [
  "Gestion & prise des licences",
  "Affiliation / Réaffiliation",
  "Statistiques & exports",
  "Finances & paiements multi-canaux",
  "Multi-rôles & espaces dédiés",
  "Environnement & infra dédiés",
  "Reprise & migration des données",
];
const federaleFeatures = [
  "Formations — inscriptions, suivi présence",
  "Publication & communication",
  "Outils BI & reporting avancé",
  "Agenda fédéral & Planning",
  "Gestion documentaire (GED)",
];
---

<Layout title="Tarifs — Fedora" description="Deux plans, une tarification transparente : du socle licences au pilotage complet de votre fédération.">
  <Nav theme="light" />

  <main class="page">
    <div class="wrap">
      <div class="eyebrow">Tarifs</div>
      <h1>Une plateforme, deux plans<span class="dot">.</span></h1>
      <p class="sub">Du socle licences au pilotage complet de votre fédération. Tarification transparente, sans surprise.</p>

      <div class="plans">
        <div class="plan">
          <div class="ptag">Le socle · pour démarrer</div>
          <div class="pname">Gestion des Licences</div>
          <div class="pdesc">Tout ce qu'il faut pour digitaliser vos licences et vos affiliations.</div>
          <ul>
            {socleFeatures.map((f) => (
              <li><svg class="chk" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="#F07A20" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7" /></svg>{f}</li>
            ))}
            <li><svg class="chk" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="#F07A20" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7" /></svg>App mobile licencié <span class="opt">— en option</span></li>
          </ul>
          <a href="/demo" class="cta ghost">Demander un devis</a>
        </div>

        <div class="plan hi">
          <span class="reco">Recommandé</span>
          <div class="ptag">Le pilotage complet</div>
          <div class="pname">Gestion Fédérale</div>
          <div class="pdesc">Toute la puissance du socle, plus les modules de croissance.</div>
          <div class="plus">Tout le plan Gestion des Licences, plus :</div>
          <ul>
            {federaleFeatures.map((f) => (
              <li><svg class="chk" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="#F07A20" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7" /></svg>{f}</li>
            ))}
            <li><svg class="chk" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="#F07A20" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7" /></svg>Compétitions <span class="opt">— développement spécifique</span></li>
          </ul>
          <a href="/demo" class="cta solid">Demander une démo</a>
        </div>
      </div>

      <div class="model">
        <div class="mcard"><div class="mt">Mise en place</div><div class="mv">5 000–10 000 €<small>Setup, facturé une fois au démarrage</small></div></div>
        <div class="mcard"><div class="mt">Abonnement</div><div class="mv">1 – 4,75 %<small>du volume de licences, selon l'offre & le PSP</small></div></div>
        <div class="mcard"><div class="mt">Sur-mesure</div><div class="mv">Sur devis<small>Modules personnalisés & développements spécifiques</small></div></div>
      </div>

      <div class="example">
        <div class="ei">€</div>
        <div class="et"><b>Exemple concret —</b> une fédération de <b>5 000 licenciés à 35 €</b> la licence, avec HelloAsso : <b>5 000 € de setup</b> + <b>7 500 €/an</b> pour le plan Gestion Fédérale (puis 7 500 €/an les années suivantes).</div>
      </div>

      <div class="reassure"><b>Déploiement accompagné</b> &nbsp;·&nbsp; reprise & migration incluses &nbsp;·&nbsp; hébergement souverain <b>HDS 100 % français</b></div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .page { background: var(--cloud); }
  .wrap { max-width: 1140px; margin: 0 auto; padding: 60px 40px 70px; }
  .eyebrow { text-align: center; font-weight: 600; font-size: 14px; letter-spacing: .16em; text-transform: uppercase; color: var(--orange); margin-bottom: 14px; }
  h1 { font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 51px; letter-spacing: -.02em; text-align: center; line-height: 1.05; margin: 0; }
  h1 .dot { color: var(--orange); }
  .sub { text-align: center; font-size: 20px; color: var(--muted); margin: 14px auto 44px; max-width: 600px; line-height: 1.55; }

  .plans { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .plan { border-radius: 18px; padding: 34px 32px; border: 1px solid var(--line); background: #fff; display: flex; flex-direction: column; }
  .plan.hi { background: var(--navy); color: #fff; border-color: var(--navy); position: relative; }
  .ptag { font-size: 13px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--orange); }
  .reco { position: absolute; top: 20px; right: 24px; background: var(--orange); color: #fff; font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; padding: 5px 11px; border-radius: 999px; }
  .pname { font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 30px; margin: 10px 0 6px; }
  .pdesc { font-size: 15px; color: var(--muted); margin-bottom: 22px; }
  .plan.hi .pdesc { color: rgba(255,255,255,.7); }
  .plus { font-size: 14.5px; font-weight: 700; color: var(--orange); margin-bottom: 14px; }
  ul { list-style: none; flex: 1; margin: 0; padding: 0; }
  li { display: flex; align-items: flex-start; gap: 11px; padding: 9px 0; font-size: 15.5px; font-weight: 500; border-bottom: 1px solid var(--line); }
  .plan.hi li { border-bottom-color: rgba(255,255,255,.1); }
  li:last-child { border-bottom: none; }
  .chk { flex: none; margin-top: 1px; }
  .opt { color: var(--muted); font-weight: 500; }
  .plan.hi .opt { color: rgba(255,255,255,.6); }
  .cta { margin-top: 26px; text-align: center; font-weight: 600; font-size: 16.5px; padding: 14px; border-radius: 11px; text-decoration: none; }
  .cta.ghost { border: 1.5px solid var(--navy); color: var(--navy); }
  .cta.solid { background: var(--orange); color: #fff; }

  .model { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 32px; }
  .mcard { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 22px; }
  .mcard .mt { font-size: 13px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin-bottom: 10px; }
  .mcard .mv { font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 26px; line-height: 1.1; }
  .mcard .mv small { font-family: "Inter", sans-serif; font-weight: 600; font-size: 14px; color: var(--muted); display: block; margin-top: 6px; }

  .example { margin-top: 24px; background: var(--orange-soft); border: 1px solid #f6d9be; border-radius: 14px; padding: 22px 26px; display: flex; gap: 16px; align-items: flex-start; }
  .example .ei { flex: none; width: 38px; height: 38px; border-radius: 10px; background: var(--orange); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-family: "Gabarito", sans-serif; }
  .example .et { font-size: 15.5px; line-height: 1.55; color: #7a4a17; }
  .example .et b { color: var(--navy); }
  .reassure { text-align: center; margin-top: 32px; font-size: 15px; color: var(--muted); }
  .reassure b { color: var(--navy); }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 820px) {
    .plans { grid-template-columns: 1fr; }
    .model { grid-template-columns: 1fr; }
  }
  @media (max-width: 620px) {
    .wrap { padding: 44px 20px 60px; }
    h1 { font-size: 36px; }
    .sub { font-size: 21px; margin-bottom: 34px; }
    .plan { padding: 28px 22px; }
    .example { flex-direction: column; gap: 12px; }
  }
</style>
