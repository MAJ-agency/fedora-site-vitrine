---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const cats = [
  { t: "Blog", d: "Actualités, conseils et retours d'expérience du sport fédéral.", icon: `<path d="M4 4h16v4H4zM4 12h10M4 17h7"/>` },
  { t: "Guides", d: "Méthodes pas à pas pour digitaliser licences, finances et affiliation.", icon: `<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>` },
  { t: "Webinaires", d: "Sessions en ligne pour prendre en main la plateforme et ses modules.", icon: `<path d="M23 7l-7 5 7 5V7zM1 5h15v14H1z"/>` },
  { t: "Livres blancs", d: "Analyses de fond sur la souveraineté, la conformité et la gestion des licences.", icon: `<path d="M12 2l3 6 6 .5-4.5 4 1.5 6L12 15l-6 3.5 1.5-6L3 8.5 9 8z"/>` },
];
const articles = [
  { cat: "Guide", t: "Réussir sa migration vers une plateforme de gestion de licences", ex: "Les étapes clés pour reprendre vos données sans repartir de zéro et embarquer vos clubs." },
  { cat: "Article", t: "Reversements et quote-parts : comment tout automatiser", ex: "Le fonctionnement des quote-parts par échelon, et comment Fedora les calcule seul." },
  { cat: "Livre blanc", t: "HDS, SecNumCloud : la souveraineté des données pour une fédération", ex: "Ce que recouvrent les certifications, et pourquoi elles comptent pour vos licenciés." },
];
const ic = (i) => `<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#F07A20" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${i}</svg>`;
---

<Layout title="Ressources — Fedora" description="Blog, guides, webinaires et livres blancs pour réussir la digitalisation de votre fédération.">
  <section class="hero">
    <Nav />
    <div class="container hero-body">
      <div class="eyebrow">Ressources</div>
      <h1>Tout pour réussir votre digitalisation<span class="dot">.</span></h1>
      <p class="hsub">Guides, articles, webinaires et livres blancs — pour vous former, vous inspirer et avancer sereinement.</p>
    </div>
  </section>

  <section class="sec light">
    <div class="container">
      <div class="cats">
        {cats.map((c) => (
          <a class="cat" href="#">
            <span class="ib" set:html={ic(c.icon)} />
            <h3>{c.t}</h3>
            <p>{c.d}</p>
            <span class="more">Explorer →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="container">
      <div class="eyebrow2">À la une</div>
      <h2>Les incontournables du moment.</h2>
      <div class="arts">
        {articles.map((a) => (
          <a class="art" href="#">
            <div class="thumb"><span class="tag">{a.cat}</span></div>
            <div class="body">
              <h4>{a.t}</h4>
              <p>{a.ex}</p>
              <span class="more">Lire →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec dark finalcta">
    <div class="container center">
      <h2>Une question sur votre projet ?</h2>
      <p class="lead center">Nos équipes vous accompagnent, du cadrage au déploiement.</p>
      <div class="ctas center"><a class="btn-primary" href="/demo">Demander une démo</a><a class="btn-ghost" href="/clients">Voir nos clients</a></div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .container { max-width: var(--maxw); margin: 0 auto; padding: 0 40px; }
  .sec { padding: 88px 0; }
  .sec.light { background: var(--cloud); }
  .dark { background: var(--navy); color: #fff; }
  h2 { font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 37px; line-height: 1.1; letter-spacing: -.02em; margin: 0 0 40px; }
  .eyebrow2 { font-weight: 600; font-size: 15.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--orange); margin-bottom: 14px; }
  .lead { font-size: 21px; line-height: 1.6; color: var(--muted); } .dark .lead { color: #aeb8c7; }
  .center { text-align: center; } .center.lead, .lead.center { margin: 0 auto; max-width: 620px; }
  .btn-primary { display: inline-block; background: var(--orange); color: #fff; font-weight: 600; font-size: 17px; padding: 15px 26px; border-radius: 12px; text-decoration: none; }
  .btn-ghost { display: inline-block; border: 1px solid rgba(255,255,255,.3); color: #fff; font-weight: 600; font-size: 17px; padding: 15px 24px; border-radius: 12px; text-decoration: none; }
  .ib { width: 48px; height: 48px; border-radius: 12px; background: var(--orange-soft); display: flex; align-items: center; justify-content: center; }

  .hero { position: relative; background: var(--navy); color: #fff; padding: 0 0 72px; overflow: hidden; }
  .hero::before { content: ""; position: absolute; inset: 0; background-image: radial-gradient(rgba(255,255,255,.05) 1px, transparent 1px); background-size: 24px 24px; opacity: .7; }
  .hero::after { content: ""; position: absolute; width: 760px; height: 760px; right: -200px; top: -300px; background: radial-gradient(circle, rgba(240,122,32,.16), transparent 62%); }
  .hero-body { position: relative; z-index: 1; padding-top: 40px; }
  .eyebrow { font-weight: 600; font-size: 15.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--orange); margin-bottom: 14px; }
  h1 { font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 53px; line-height: 1.05; letter-spacing: -.02em; margin: 0 0 16px; max-width: 760px; }
  h1 .dot { color: var(--orange); }
  .hsub { font-size: 21px; line-height: 1.58; color: #aeb8c7; max-width: 600px; margin: 0; }

  .cats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  .cat { display: block; background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 28px; text-decoration: none; color: inherit; transition: transform .15s, box-shadow .15s; }
  .cat:hover { transform: translateY(-3px); box-shadow: 0 20px 40px -24px rgba(13,30,53,.3); }
  .cat h3 { font-family: "Gabarito", sans-serif; font-weight: 700; font-size: 21px; margin: 16px 0 8px; }
  .cat p { font-size: 16px; color: var(--muted); line-height: 1.5; margin: 0 0 14px; }
  .more { font-weight: 600; font-size: 16px; color: var(--orange); }

  .arts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .art { display: block; background: #fff; border: 1px solid var(--line); border-radius: 18px; overflow: hidden; text-decoration: none; color: inherit; transition: transform .15s, box-shadow .15s; }
  .art:hover { transform: translateY(-3px); box-shadow: 0 20px 40px -24px rgba(13,30,53,.3); }
  .thumb { height: 120px; background: linear-gradient(135deg, #16305a, var(--navy)); position: relative; }
  .thumb .tag { position: absolute; left: 18px; bottom: 14px; font-size: 12px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: #fff; background: var(--orange); padding: 4px 10px; border-radius: 999px; }
  .art .body { padding: 22px; }
  .art h4 { font-family: "Gabarito", sans-serif; font-weight: 700; font-size: 19px; line-height: 1.3; margin: 0 0 8px; }
  .art p { font-size: 16px; color: var(--muted); line-height: 1.5; margin: 0 0 14px; }

  .finalcta { text-align: center; } .finalcta h2 { font-size: 42px; margin-bottom: 14px; } .finalcta .ctas { justify-content: center; margin-top: 26px; }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 860px) {
    .cats { grid-template-columns: repeat(2, 1fr); }
    .arts { grid-template-columns: 1fr; }
  }
  @media (max-width: 620px) {
    .container { padding: 0 20px; }
    .sec { padding: 56px 0; }
    .hero { padding-bottom: 56px; }
    h1 { font-size: 35px; }
    h2 { font-size: 28px; }
    .hsub { font-size: 21px; }
    .cats { grid-template-columns: 1fr; }
    .finalcta h2 { font-size: 32px; }
  }
</style>
