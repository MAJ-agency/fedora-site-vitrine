---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { MODULES } from "../../data/modules.js";

export function getStaticPaths() {
  return Object.keys(MODULES).map((slug) => ({ params: { slug }, props: { m: MODULES[slug] } }));
}

const { m } = Astro.props;
const ck = (i) => `<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="#F07A20" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${i}</svg>`;
---

<Layout title={`${m.name} — Fedora`} description={m.sub}>
  <section class="hero">
    <Nav />
    <div class="container hero-body">
      <div class="crumb">Produit <b>›</b> {m.name}</div>
      <div class="eyebrow">{m.tag}</div>
      <h1>{m.title.replace(/\.$/, "")}<span class="dot">.</span></h1>
      <p class="hsub">{m.sub}</p>
      <div class="ctas">
        <a class="btn-primary" href="/demo">Demander une démo</a>
        {m.related ? <a class="btn-ghost" href={m.related.href}>{m.related.label}</a> : <a class="btn-ghost" href="/tarifs">Voir les tarifs</a>}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="container">
      <div class="eyebrow2 center">Ce que ça apporte</div>
      <h2 class="center">{m.name}, en trois points.</h2>
      <div class="grid3">
        {m.features.map((f) => (
          <div class="bcard"><span class="ib" set:html={ck(f.icon)} /><h3>{f.t}</h3><p>{f.d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec dark finalcta">
    <div class="container center">
      <h2>Activez {m.name.toLowerCase()} pour votre fédération.</h2>
      <p class="lead center">Disponible dans le plan Gestion Fédérale, ou en module sur-mesure.</p>
      <div class="ctas center"><a class="btn-primary" href="/demo">Demander une démo</a><a class="btn-ghost" href="/tarifs">Voir les tarifs</a></div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .container { max-width: var(--maxw); margin: 0 auto; padding: 0 40px; }
  .sec { padding: 90px 0; }
  .dark { background: var(--navy); color: #fff; }
  h2 { font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 37px; line-height: 1.1; letter-spacing: -.02em; margin: 0; }
  .eyebrow2 { font-weight: 600; font-size: 15.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--orange); margin-bottom: 14px; }
  .lead { font-size: 21px; line-height: 1.6; color: var(--muted); }
  .dark .lead { color: #aeb8c7; }
  .center { text-align: center; } .center.lead, .lead.center { margin-left: auto; margin-right: auto; max-width: 620px; }
  .btn-primary { display: inline-block; background: var(--orange); color: #fff; font-weight: 600; font-size: 17px; padding: 15px 26px; border-radius: 12px; text-decoration: none; }
  .btn-ghost { display: inline-block; border: 1px solid rgba(255,255,255,.3); color: #fff; font-weight: 600; font-size: 17px; padding: 15px 24px; border-radius: 12px; text-decoration: none; }
  .ib { width: 48px; height: 48px; border-radius: 12px; background: var(--orange-soft); display: flex; align-items: center; justify-content: center; }

  .hero { position: relative; background: var(--navy); color: #fff; padding: 0 0 84px; overflow: hidden; }
  .hero::before { content: ""; position: absolute; inset: 0; background-image: radial-gradient(rgba(255,255,255,.05) 1px, transparent 1px); background-size: 24px 24px; opacity: .7; }
  .hero::after { content: ""; position: absolute; width: 760px; height: 760px; right: -200px; top: -300px; background: radial-gradient(circle, rgba(240,122,32,.16), transparent 62%); }
  .hero-body { position: relative; z-index: 1; padding-top: 40px; }
  .crumb { font-size: 15.5px; color: #8595ac; margin-bottom: 14px; } .crumb b { color: #c7d2e0; }
  .eyebrow { font-weight: 600; font-size: 15.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--orange); margin-bottom: 14px; }
  h1 { font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 55px; line-height: 1.04; letter-spacing: -.02em; margin: 0 0 18px; max-width: 760px; }
  h1 .dot { color: var(--orange); }
  .hsub { font-size: 21px; line-height: 1.58; color: #aeb8c7; max-width: 620px; margin: 0 0 26px; }
  .ctas { display: flex; gap: 14px; }

  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 48px; }
  .bcard { background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 28px; }
  .bcard h3 { font-family: "Gabarito", sans-serif; font-weight: 700; font-size: 22px; margin: 16px 0 8px; }
  .bcard p { font-size: 17.5px; color: var(--muted); line-height: 1.5; }

  .finalcta { text-align: center; } .finalcta h2 { font-size: 42px; margin-bottom: 14px; } .finalcta .ctas { justify-content: center; margin-top: 26px; }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 860px) {
    .grid3 { grid-template-columns: 1fr; }
  }
  @media (max-width: 620px) {
    .container { padding: 0 20px; }
    .sec { padding: 56px 0; }
    .hero { padding-bottom: 56px; }
    h1 { font-size: 36px; }
    h2 { font-size: 28px; }
    .hsub { font-size: 21px; }
    .ctas { flex-direction: column; align-items: stretch; }
    .btn-primary, .btn-ghost { text-align: center; }
    .finalcta h2 { font-size: 32px; }
  }
</style>
