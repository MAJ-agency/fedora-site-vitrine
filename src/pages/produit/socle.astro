---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";

const rows = [
  { av: "CM", n: "Camille Martin", disc: "Judo", type: "Compétition", st: "ok", stl: "● Validée", no: "2025-FFJ-004821" },
  { av: "LB", n: "Lucas Bernard", disc: "Judo", type: "Loisir", st: "wait", stl: "● En attente CM", no: "2025-FFJ-004822" },
  { av: "AD", n: "Aïcha Diallo", disc: "Ju-jitsu", type: "Compétition", st: "ok", stl: "● Validée", no: "2025-FFJ-004823" },
  { av: "TR", n: "Théo Rossi", disc: "Judo", type: "Découverte", st: "new", stl: "● Nouvelle", no: "2025-FFJ-004824" },
  { av: "EM", n: "Emma Moreau", disc: "Taïso", type: "Loisir", st: "ok", stl: "● Validée", no: "2025-FFJ-004825" },
];
const chk = `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#F07A20" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>`;
const spcIcon = (i) => `<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#F07A20" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${i}</svg>`;
---

<Layout title="Le socle — Gestion des licences | Fedora" description="Le cœur de Fedora, inclus dans chaque plan : parcours personnalisables, paiements multi-canaux, espaces dédiés et statistiques.">
  <section class="hero">
    <Nav />
    <div class="container hero-body">
      <div class="crumb">Produit <b>›</b> Le socle — Gestion des licences</div>
      <span class="incl">✔ Inclus dans chaque plan</span>
      <h1>La gestion des licences, de la prise à l'affiliation<span class="dot">.</span></h1>
      <p class="hsub">Le cœur de Fedora : parcours personnalisables, paiements multi-canaux, espaces dédiés et statistiques. Tout ce qu'il faut pour digitaliser votre gestion, dès le premier jour.</p>
      <div class="ctas"><a class="btn-primary" href="/demo">Demander une démo</a><a class="btn-ghost" href="/tarifs">Voir les tarifs</a></div>

      <div class="tablecard">
        <div class="tc-head"><span class="t">Licences · Saison 2025-26</span><div class="tc-tools"><span class="chipf on">Toutes</span><span class="chipf">Validées</span><span class="chipf">En attente</span><span class="chipf">+ Filtrer</span></div></div>
        <table>
          <tr><th>Licencié</th><th>Discipline</th><th>Type</th><th>Statut</th><th>N° licence</th></tr>
          {rows.map((r) => (
            <tr>
              <td><div class="who"><span class="av">{r.av}</span> {r.n}</div></td>
              <td>{r.disc}</td>
              <td>{r.type}</td>
              <td><span class={`st ${r.st}`}>{r.stl}</span></td>
              <td><span class="mono">{r.no}</span></td>
            </tr>
          ))}
        </table>
      </div>
    </div>
  </section>

  <!-- FEATURE 1 -->
  <section class="sec light">
    <div class="container">
      <div class="frow">
        <div class="txt">
          <div class="feat-tag">Parcours personnalisables</div>
          <h2>Chaque fédération a ses règles. Fedora s'y plie.</h2>
          <p class="lead">Types de licences, catégories d'âge, disciplines, options, tarifs dégressifs, pièces à fournir… Configurez vos parcours de prise de licence exactement comme votre réglementation l'exige.</p>
          <div class="flist">
            <div class="fli"><span class="ck" set:html={chk} /> Types &amp; catégories entièrement paramétrables</div>
            <div class="fli"><span class="ck" set:html={chk} /> Certificat médical &amp; questionnaire santé intégrés</div>
            <div class="fli"><span class="ck" set:html={chk} /> Champs personnalisés selon vos besoins</div>
          </div>
        </div>
        <div class="vis">
          <div class="mock">
            <div class="mk-h"><span>Nouvelle licence · choix de la formule</span><span class="badge">Étape 1/3</span></div>
            <div class="opt sel"><span class="rd"></span> Licence Compétition <span class="pr">180 €</span></div>
            <div class="opt"><span class="rd"></span> Licence Loisir <span class="pr">95 €</span></div>
            <div class="opt"><span class="rd"></span> Licence Découverte <span class="pr">45 €</span></div>
            <div class="opt"><span class="rd"></span> Titre de participation (ATP) <span class="pr">12 €</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURE 2 -->
  <section class="sec">
    <div class="container">
      <div class="frow rev">
        <div class="txt">
          <div class="feat-tag">Paiements multi-canaux</div>
          <h2>Encaissez comme vos adhérents le souhaitent.</h2>
          <p class="lead">Carte bancaire, prélèvement SEPA, chèque, espèces, paiement en plusieurs fois… Les paiements sont suivis, rapprochés et reversés automatiquement à chaque structure.</p>
          <div class="flist">
            <div class="fli"><span class="ck" set:html={chk} /> PSP au choix : Lemonway ou HelloAsso</div>
            <div class="fli"><span class="ck" set:html={chk} /> Reversements &amp; quote-parts automatiques</div>
            <div class="fli"><span class="ck" set:html={chk} /> Pass'Sport &amp; aides intégrés</div>
          </div>
        </div>
        <div class="vis">
          <div class="mock">
            <div class="mk-h"><span>Paiement de la licence</span><span class="badge">Sécurisé</span></div>
            <div class="paygrid">
              <div class="paytile sel"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#0D1E35" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"></rect><path d="M2 10h20"></path></svg>Carte</div>
              <div class="paytile"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#0D1E35" stroke-width="2"><path d="M3 10h18M7 15h4M5 5h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z"></path></svg>SEPA</div>
              <div class="paytile"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#0D1E35" stroke-width="2"><rect x="3" y="6" width="18" height="12" rx="2"></rect><path d="M7 10h6"></path></svg>Chèque</div>
            </div>
            <div class="payrow"><span>Licence Compétition</span><b>180,00 €</b></div>
            <div class="paybtn">Payer en 3× sans frais</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURE 3 -->
  <section class="sec light">
    <div class="container">
      <div class="frow">
        <div class="txt">
          <div class="feat-tag">Statistiques &amp; exports</div>
          <h2>Vos chiffres, prêts à décider et à transmettre.</h2>
          <p class="lead">Tableaux de bord en temps réel, indicateurs clés par structure et par discipline, évolution des licences saison après saison. Exportez tout en un clic pour vos tutelles.</p>
          <div class="flist">
            <div class="fli"><span class="ck" set:html={chk} /> Dashboards par ligue, comité, club</div>
            <div class="fli"><span class="ck" set:html={chk} /> Exports CSV, Excel &amp; rapports normés</div>
            <div class="fli"><span class="ck" set:html={chk} /> Comparatifs inter-saisons</div>
          </div>
        </div>
        <div class="vis">
          <div class="mock">
            <div class="mk-h"><span>Vue d'ensemble · licences</span><span class="badge">Temps réel</span></div>
            <div class="kpis">
              <div class="kp"><div class="k">Total licences</div><div class="v">12 480 <small>▲ 8,2%</small></div></div>
              <div class="kp"><div class="k">Taux de renouvellement</div><div class="v">91%</div></div>
            </div>
            <div class="bars"><div class="b" style="height:44%"></div><div class="b" style="height:58%"></div><div class="b" style="height:50%"></div><div class="b" style="height:72%"></div><div class="b o" style="height:100%"></div><div class="b" style="height:66%"></div></div>
            <div class="expbtn"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#0D1E35" stroke-width="2"><path d="M12 3v12M8 11l4 4 4-4M4 21h16"></path></svg> Exporter (CSV, Excel)</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ESPACES -->
  <section class="sec dark">
    <div class="container">
      <div class="eyebrow2 center">Espaces dédiés</div>
      <h2 class="center">Chacun son espace, chacun son périmètre.</h2>
      <p class="lead center">Le même socle, décliné pour chaque acteur — avec les bons droits et la bonne vue.</p>
      <div class="grid3">
        <div class="spc"><span class="ib" set:html={spcIcon(`<path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"/>`)} /><h3>Espace Fédéral, Ligue & Comité</h3><p>Pilotage consolidé du réseau, reversements, conformité et exports institutionnels.</p></div>
        <div class="spc"><span class="ib" set:html={spcIcon(`<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"/>`)} /><h3>Espace Club</h3><p>Inscriptions, cotisations, base membres — simple, pour des bénévoles.</p></div>
        <div class="spc"><span class="ib" set:html={spcIcon(`<rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/>`)} /><h3>Espace Licencié</h3><p>Licence numérique, QR code, renouvellement et agenda dans l'app mobile.</p></div>
      </div>
    </div>
  </section>

  <section class="sec dark finalcta">
    <div class="container center">
      <h2>Le socle est prêt. Votre fédération aussi ?</h2>
      <p class="lead center">Une démo sur vos vrais parcours de licence, et un chiffrage adapté à votre volume.</p>
      <div class="ctas center"><a class="btn-primary" href="/demo">Demander une démo</a><a class="btn-ghost" href="/tarifs">Voir les tarifs</a></div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .container { max-width: var(--maxw); margin: 0 auto; padding: 0 40px; }
  .sec { padding: 88px 0; }
  .dark { background: var(--navy); color: #fff; }
  .light { background: var(--cloud); }
  h2 { font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 34px; line-height: 1.1; letter-spacing: -.02em; margin: 0; }
  .eyebrow2 { font-weight: 600; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--orange); margin-bottom: 14px; }
  .lead { font-size: 17px; line-height: 1.6; color: var(--muted); }
  .dark .lead { color: #aeb8c7; }
  .center { text-align: center; } .center.lead, .lead.center { margin-left: auto; margin-right: auto; max-width: 640px; }
  .btn-primary { display: inline-block; background: var(--orange); color: #fff; font-weight: 600; font-size: 16px; padding: 15px 26px; border-radius: 12px; text-decoration: none; }
  .btn-ghost { display: inline-block; border: 1px solid rgba(255,255,255,.3); color: #fff; font-weight: 600; font-size: 16px; padding: 15px 24px; border-radius: 12px; text-decoration: none; }
  .feat-tag { display: inline-flex; align-items: center; gap: 8px; font-size: 12.5px; font-weight: 600; color: var(--orange); text-transform: uppercase; letter-spacing: .1em; margin-bottom: 16px; }

  .hero { position: relative; background: var(--navy); color: #fff; padding: 0 0 80px; overflow: hidden; }
  .hero::before { content: ""; position: absolute; inset: 0; background-image: radial-gradient(rgba(255,255,255,.05) 1px, transparent 1px); background-size: 24px 24px; opacity: .7; }
  .hero::after { content: ""; position: absolute; width: 760px; height: 760px; right: -200px; top: -300px; background: radial-gradient(circle, rgba(240,122,32,.16), transparent 62%); }
  .hero-body { position: relative; z-index: 1; padding-top: 40px; max-width: 100%; }
  .crumb { font-size: 13px; color: #8595ac; margin-bottom: 14px; } .crumb b { color: #c7d2e0; }
  .incl { display: inline-flex; align-items: center; gap: 8px; font-size: 12.5px; font-weight: 600; color: #34d399; background: rgba(52,211,153,.12); border: 1px solid rgba(52,211,153,.3); padding: 6px 13px; border-radius: 999px; margin-bottom: 20px; }
  h1 { font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 50px; line-height: 1.04; letter-spacing: -.02em; margin: 0 0 18px; max-width: 720px; }
  h1 .dot { color: var(--orange); }
  .hsub { font-size: 18px; line-height: 1.58; color: #aeb8c7; max-width: 600px; margin: 0 0 26px; }
  .ctas { display: flex; gap: 14px; margin-bottom: 44px; }

  /* licence table */
  .tablecard { background: linear-gradient(180deg, #16305a, #122444); border: 1px solid rgba(255,255,255,.1); border-radius: 18px; padding: 20px 22px; box-shadow: 0 40px 80px -24px rgba(0,0,0,.6); }
  .tc-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
  .tc-head .t { font-weight: 600; font-size: 15px; }
  .tc-tools { display: flex; gap: 8px; }
  .chipf { font-size: 11.5px; font-weight: 600; color: #c7d2e0; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1); padding: 6px 12px; border-radius: 8px; }
  .chipf.on { color: #fff; background: rgba(240,122,32,.18); border-color: rgba(240,122,32,.4); }
  table { width: 100%; border-collapse: collapse; }
  th { text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: #7c8aa3; font-weight: 600; padding: 8px 10px; border-bottom: 1px solid rgba(255,255,255,.1); }
  td { font-size: 13.5px; padding: 12px 10px; border-bottom: 1px solid rgba(255,255,255,.06); color: #e6ecf5; }
  td .who { display: flex; align-items: center; gap: 10px; }
  td .av { width: 26px; height: 26px; border-radius: 50%; background: rgba(255,255,255,.12); display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; flex: none; }
  .st { font-size: 11.5px; font-weight: 700; padding: 4px 10px; border-radius: 999px; display: inline-block; }
  .st.ok { color: #34d399; background: rgba(52,211,153,.14); }
  .st.wait { color: #f0a020; background: rgba(240,160,32,.14); }
  .st.new { color: #5aa9ff; background: rgba(90,169,255,.14); }
  td .mono { font-family: "JetBrains Mono", monospace; font-size: 12.5px; color: #aeb8c7; }

  /* feature rows */
  .frow { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  .frow.rev .txt { order: 2; } .frow.rev .vis { order: 1; }
  .frow h2 { margin-bottom: 14px; }
  .flist { margin-top: 22px; display: flex; flex-direction: column; gap: 12px; }
  .fli { display: flex; gap: 11px; font-size: 15px; font-weight: 500; align-items: flex-start; }
  .fli .ck { flex: none; }
  .mock { background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 22px; box-shadow: 0 24px 50px -28px rgba(13,30,53,.35); }
  .mk-h { font-weight: 700; font-size: 14px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center; }
  .mk-h .badge { font-size: 11px; font-weight: 700; color: var(--orange); background: var(--orange-soft); padding: 4px 10px; border-radius: 999px; }
  .opt { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 11px; margin-bottom: 10px; font-size: 14px; font-weight: 600; }
  .opt.sel { border-color: var(--orange); background: var(--orange-soft); }
  .opt .rd { width: 18px; height: 18px; border-radius: 50%; border: 2px solid var(--line); }
  .opt.sel .rd { border-color: var(--orange); background: var(--orange); box-shadow: inset 0 0 0 3px #fff; }
  .opt .pr { margin-left: auto; font-family: "JetBrains Mono", monospace; font-weight: 700; font-size: 14px; color: var(--navy); }
  .paygrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 16px; }
  .paytile { border: 1px solid var(--line); border-radius: 11px; padding: 14px 10px; text-align: center; font-size: 12px; font-weight: 600; }
  .paytile.sel { border-color: var(--orange); background: var(--orange-soft); }
  .paytile svg { display: block; margin: 0 auto 8px; }
  .payrow { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-top: 1px solid var(--line); font-size: 14px; }
  .payrow b { font-family: "JetBrains Mono", monospace; font-weight: 700; font-size: 18px; }
  .paybtn { margin-top: 14px; text-align: center; background: var(--orange); color: #fff; font-weight: 600; font-size: 14px; padding: 12px; border-radius: 10px; }
  .kpis { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px; }
  .kp { background: var(--cloud); border-radius: 11px; padding: 13px 15px; }
  .kp .k { font-size: 11.5px; color: var(--muted); margin-bottom: 5px; }
  .kp .v { font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 22px; } .kp .v small { font-family: "Inter", sans-serif; font-size: 12px; font-weight: 600; color: var(--good); margin-left: 4px; }
  .bars { display: flex; align-items: flex-end; gap: 10px; height: 96px; padding: 0 4px; }
  .bars .b { flex: 1; background: var(--line); border-radius: 6px 6px 0 0; }
  .bars .b.o { background: var(--orange); }
  .expbtn { margin-top: 16px; display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: var(--navy); border: 1px solid var(--line); padding: 9px 14px; border-radius: 9px; }

  /* espaces */
  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 44px; }
  .spc { background: var(--navy-soft); border: 1px solid rgba(255,255,255,.1); border-radius: 18px; padding: 28px; }
  .spc .ib { width: 44px; height: 44px; border-radius: 11px; background: rgba(240,122,32,.16); display: flex; align-items: center; justify-content: center; }
  .spc h3 { font-family: "Gabarito", sans-serif; font-weight: 700; font-size: 19px; margin: 16px 0 8px; }
  .spc p { font-size: 14px; color: #aeb8c7; line-height: 1.5; }

  .finalcta { text-align: center; } .finalcta h2 { font-size: 40px; margin-bottom: 14px; } .finalcta .ctas { justify-content: center; margin-top: 26px; }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 960px) {
    .frow { grid-template-columns: 1fr; gap: 34px; }
    .frow.rev .txt { order: 1; } .frow.rev .vis { order: 2; }
    .grid3 { grid-template-columns: 1fr; }
    h1 { font-size: 42px; }
  }
  @media (max-width: 620px) {
    .container { padding: 0 20px; }
    .sec { padding: 56px 0; }
    .hero { padding-bottom: 56px; }
    h1 { font-size: 32px; }
    h2 { font-size: 25px; }
    .hsub, .lead { font-size: 16px; }
    .ctas { flex-direction: column; align-items: stretch; }
    .btn-primary, .btn-ghost { text-align: center; }
    .tablecard { overflow-x: auto; }
    table { min-width: 480px; }
    .tc-head { flex-direction: column; align-items: flex-start; gap: 12px; }
    .finalcta h2 { font-size: 30px; }
  }
</style>
