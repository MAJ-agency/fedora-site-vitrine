<script>
  const stage = document.querySelector(".stage[data-reveal]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (stage && !reduce && "IntersectionObserver" in window) {
    stage.classList.add("reveal-ready");
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            stage.classList.add("in");
            io.disconnect();
          }
        });
      },
      { threshold: 0.25 }
    );
    io.observe(stage);
  }
</script>
