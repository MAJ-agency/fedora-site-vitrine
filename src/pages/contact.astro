---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const channels = [
  { t: "Demander une démo", d: "La façon la plus rapide de voir Fedora sur vos cas d'usage.", cta: "Réserver un créneau", href: "/demo", icon: `<path d="M23 7l-7 5 7 5V7zM1 5h15v14H1z"/>` },
  { t: "Écrire à l'équipe", d: "Une question sur l'offre, la migration ou la sécurité ? On vous répond vite.", cta: "contact@fedora-app.fr", href: "mailto:contact@fedora-app.fr", icon: `<rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 7l10 6 10-6"/>` },
];
const ic = (i) => `<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#F07A20" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${i}</svg>`;
---

<Layout title="Contact — Fedora" description="Parlez à l'équipe Fedora : démo, migration, sécurité ou tarifs.">
  <Nav theme="light" />
  <section class="head">
    <div class="container">
      <div class="eyebrow">Contact</div>
      <h1>Parlons de votre fédération.</h1>
      <p class="sub">Démo, reprise de données, sécurité ou tarifs — dites-nous où vous en êtes, on vous accompagne à partir de là.</p>
    </div>
  </section>

  <section class="sec">
    <div class="container">
      <div class="grid2">
        {channels.map((c) => (
          <div class="card">
            <span class="ib" set:html={ic(c.icon)} />
            <h3>{c.t}</h3>
            <p>{c.d}</p>
            <a class="clink" href={c.href}>{c.cta} →</a>
          </div>
        ))}
      </div>

      <div class="orgcard">
        <div class="ol">Éditeur</div>
        <p><b>Fedora</b> — édité par MAJ. <span class="ph">[Raison sociale, forme juridique et capital à compléter]</span></p>
        <p class="ph">[Adresse du siège social à compléter] · SIREN/SIRET [à compléter]</p>
        <p>Hébergement souverain <b>HDS</b> (Hébergeur de Données de Santé), 100 % en France — <a href="/produit/securite">en savoir plus sur la sécurité</a>.</p>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .container { max-width: var(--maxw); margin: 0 auto; padding: 0 40px; }
  .head { background: var(--cloud); border-bottom: 1px solid var(--line); padding: 64px 0 56px; }
  .eyebrow { font-weight: 600; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--orange); margin-bottom: 14px; }
  h1 { font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 44px; line-height: 1.05; letter-spacing: -.02em; margin: 0 0 14px; }
  .sub { font-size: 18px; line-height: 1.58; color: var(--muted); max-width: 620px; margin: 0; }

  .sec { padding: 72px 0 90px; }
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .card { background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 30px; }
  .ib { width: 50px; height: 50px; border-radius: 13px; background: var(--orange-soft); display: flex; align-items: center; justify-content: center; margin-bottom: 18px; }
  .card h3 { font-family: "Gabarito", sans-serif; font-weight: 700; font-size: 20px; margin: 0 0 8px; }
  .card p { font-size: 14.5px; color: var(--muted); line-height: 1.55; margin: 0 0 16px; }
  .clink { font-weight: 600; font-size: 15px; color: var(--navy); text-decoration: none; border-bottom: 2px solid var(--orange); padding-bottom: 2px; }

  .orgcard { margin-top: 34px; background: var(--cloud); border: 1px solid var(--line); border-radius: 16px; padding: 28px 30px; }
  .orgcard .ol { font-weight: 600; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--orange); margin-bottom: 12px; }
  .orgcard p { font-size: 14.5px; color: var(--navy); line-height: 1.6; margin: 0 0 8px; }
  .orgcard p:last-child { margin-bottom: 0; color: var(--muted); }
  .orgcard a { color: var(--navy); font-weight: 600; }
  .ph { color: var(--muted); font-style: italic; }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 700px) {
    .grid2 { grid-template-columns: 1fr; }
  }
  @media (max-width: 620px) {
    .container { padding: 0 20px; }
    .head { padding: 48px 0 40px; }
    h1 { font-size: 32px; }
    .sub { font-size: 16px; }
  }
</style>
