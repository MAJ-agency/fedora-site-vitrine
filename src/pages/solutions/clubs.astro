---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";

// Mêmes 3 thèmes que la page fédérations, déclinés à la réalité d'un club
// (bénévoles, budget associatif, vie sportive locale).
const themes = [
  {
    verbe: "Digitalisez",
    sur: "En finir avec le papier et les tableurs",
    besoin:
      "Arrêter de ressaisir, de courir après les chèques et les certificats, et rendre aux bénévoles le temps qu'ils passent en paperasse.",
    features: [
      { t: "Inscriptions & adhésions en ligne", d: "Vos adhérents remplissent tout eux-mêmes, sans ressaisie de votre part." },
      { t: "Cotisations & paiements", d: "CB, SEPA, chèque, paiement en plusieurs fois — encaissés et suivis." },
      { t: "Documents collectés une fois", d: "Certificats médicaux et autorisations, rassemblés et toujours à jour." },
      { t: "Une seule base membres", d: "Plus de double saisie entre votre club et votre fédération." },
    ],
    visuel: "papier",
  },
  {
    verbe: "Pilotez",
    sur: "Savoir où en est le club, à tout moment",
    besoin:
      "Voir d'un coup d'œil qui est à jour, ce qui reste à encaisser et où en est le budget — sans passer la soirée à recouper des fichiers.",
    features: [
      { t: "Tableau de bord du club", d: "Adhérents, cotisations et échéances réunis sur un seul écran." },
      { t: "Relances automatiques", d: "Les impayés sont identifiés et relancés sans que vous ayez à y penser." },
      { t: "Budget & encaissements", d: "Vos recettes consolidées, par section et par saison." },
      { t: "Exports pour l'AG et les subventions", d: "Effectifs et bilans prêts à joindre à vos dossiers." },
    ],
    visuel: "relances",
  },
  {
    verbe: "Développez",
    sur: "Faire vivre et grandir le club",
    besoin:
      "Fidéliser vos adhérents, en attirer de nouveaux et animer la vie du club avec des outils qui donnent envie.",
    features: [
      { t: "Communication ciblée", d: "Un message à une équipe, une section ou tout le club, en direct." },
      { t: "Planning & créneaux", d: "Salles, terrains et entraînements partagés avec vos membres." },
      { t: "App mobile pour vos adhérents", d: "Leur licence, leur agenda et leur club, toujours dans la poche." },
      { t: "Inscriptions ouvertes en ligne", d: "Un lien à partager pour recruter, même hors du forum des associations." },
    ],
    visuel: "anim",
  },
];
const steps = [
  { t: "Choix de la formule", d: "L'adhérent sélectionne sa section, sa catégorie, ses options." },
  { t: "Infos & documents", d: "Coordonnées et certificat médical, importés une seule fois." },
  { t: "Paiement en ligne", d: "CB, SEPA ou paiement en plusieurs fois, sécurisé." },
  { t: "Licence délivrée", d: "La licence est émise automatiquement, disponible dans l'application." },
];
// Ancres sans accent : "Développez" -> "developpez".
const slug = (s) => s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");
---

<Layout title="Fedora pour les clubs — Gérez votre club simplement" description="Inscriptions, cotisations, licences, membres — tout au même endroit, tout simple. Pensé pour les bénévoles.">
  <section class="hero">
    <Nav />
    <div class="container hero-body">
      <div class="hgrid">
        <div>
          <div class="crumb">Solutions <b>›</b> Clubs</div>
          <div class="eyebrow">Pour les bénévoles de club</div>
          <h1>Gérez votre club sans y consacrer vos soirées<span class="dot">.</span></h1>
          <p class="hsub">Inscriptions, cotisations, licences, membres — tout au même endroit, tout simple. Plus de papier, de tableurs ni de relances manuelles.</p>
          <div class="ctas"><a class="btn-primary" href="/demo">Demander une démo</a><a class="btn-ghost" href="/tarifs">Voir les tarifs</a></div>
        </div>
        <div class="clubpanel">
          <div class="cp-head"><div class="cp-logo">AP</div><div><div class="n">AS Ploërmel</div><div class="s">Espace club · saison 2025-26</div></div></div>
          <div class="cp-stats">
            <div class="cp-stat"><div class="k">Adhérents</div><div class="v">248 <small>+12</small></div></div>
            <div class="cp-stat"><div class="k">Encaissé</div><div class="v">8 680 €</div></div>
          </div>
          <div class="cp-bar"><div class="lab"><span>Cotisations à jour</span><b>214 / 248</b></div><div class="cp-track"><i></i></div></div>
          <div class="cp-btn">+ Nouvelle inscription</div>
        </div>
      </div>
    </div>
  </section>

  <!-- INTRO DES 3 THÈMES -->
  <section class="sec light themes-intro">
    <div class="container">
      <div class="eyebrow2 center">Le quotidien d'un bénévole</div>
      <h2 class="center">Trois enjeux, une seule plateforme.</h2>
      <p class="lead center mb">Digitaliser les inscriptions, garder l'œil sur les cotisations et faire grandir le club — sans y passer vos soirées.</p>
      <div class="tnav">
        {themes.map((t, i) => (
          <a class="tnav-item" href={`#${slug(t.verbe)}`}>
            <span class="tnum">{`0${i + 1}`}</span>
            <span class="tverbe">{t.verbe}</span>
            <span class="tsur">{t.sur}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- LES 3 THÈMES DÉVELOPPÉS -->
  {themes.map((t, i) => (
    <section class={`sec theme ${i % 2 === 1 ? "light" : ""}`} id={slug(t.verbe)}>
      <div class="container">
        <div class={`trow ${i % 2 === 1 ? "rev" : ""}`}>
          <div class="tcol">
            <div class="tbadge"><span>{`0${i + 1}`}</span> {t.sur}</div>
            <h2 class="th2">{t.verbe}<span class="dot">.</span></h2>
            <p class="lead tbesoin">{t.besoin}</p>
            <div class="tfeats">
              {t.features.map((f) => (
                <div class="tfeat">
                  <span class="tck"><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="#F07A20" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"></path></svg></span>
                  <div><b>{f.t}</b><span>{f.d}</span></div>
                </div>
              ))}
            </div>
          </div>

          <div class="tvis">
            {t.visuel === "papier" && (
              <div class="vcard">
                <div class="vhead"><span>Dossier d'inscription</span><span class="vtag">Zéro papier</span></div>
                <div class="vstep done"><i></i> Fiche d'inscription <b>remplie en ligne</b></div>
                <div class="vstep done"><i></i> Certificat médical <b>importé</b></div>
                <div class="vstep done"><i></i> Autorisation parentale <b>signée</b></div>
                <div class="vstep done"><i></i> Cotisation <b>réglée par CB</b></div>
                <div class="vfoot">Transmis à la fédération <b>sans ressaisie</b></div>
              </div>
            )}
            {t.visuel === "relances" && (
              <div class="vcard">
                <div class="vhead"><span>Suivi des cotisations</span><span class="vtag live">● À jour</span></div>
                <div class="vkpis">
                  <div><span>Adhérents</span><b>248</b><em>▲ 12</em></div>
                  <div><span>À jour</span><b>214</b><em>86 %</em></div>
                  <div><span>Encaissé</span><b>8 680 €</b><em>saison</em></div>
                </div>
                <div class="vnotif"><span class="vdot o"></span><div><b>34 cotisations en attente</b><span>Relance automatique envoyée hier</span></div></div>
                <div class="vfoot">Export effectifs <b>prêt pour votre dossier de subvention</b></div>
              </div>
            )}
            {t.visuel === "anim" && (
              <div class="vcard">
                <div class="vhead"><span>Vie du club</span><span class="vtag">Module</span></div>
                <div class="vnotif"><span class="vdot"></span><div><b>Entraînement déplacé à 18 h</b><span>Notifié aux 24 membres de l'équipe U15</span></div></div>
                <div class="vnotif"><span class="vdot o"></span><div><b>Créneau salle B réservé</b><span>Samedi 10 h — 12 h · confirmé</span></div></div>
                <div class="vnotif"><span class="vdot"></span><div><b>12 nouvelles inscriptions</b><span>Reçues via le lien partagé sur vos réseaux</span></div></div>
                <div class="vfoot">Vos adhérents suivent tout depuis <b>l'app mobile</b></div>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- ZOOM : L'ADHÉSION EN LIGNE -->
  <section class="sec dark">
    <div class="container">
      <div class="eyebrow2 center">Zoom — Le moment de vérité</div>
      <h2 class="center">De l'inscription à la licence, en 3 minutes.</h2>
      <p class="lead center mb">C'est le passage où un club perd le plus d'adhérents : formulaire papier, chèque à déposer, certificat oublié. En ligne, l'adhérent va au bout sans quitter son canapé.</p>
      <div class="steps">
        {steps.map((s, i) => (<div class="step"><div class="num">{i + 1}</div><h4>{s.t}</h4><p>{s.d}</p></div>))}
      </div>
    </div>
  </section>

  <section class="sec light">
    <div class="container quote">
      <div class="eyebrow2 center">Ils l'ont adopté</div>
      <div class="big">« Avant, je passais mes dimanches sur Excel à pointer les cotisations. Aujourd'hui, tout est à jour tout seul — je peux enfin m'occuper du club, pas de la paperasse. »</div>
      <div class="who"><b>Sophie L.</b> — Secrétaire, club de judo · 240 licenciés</div>
    </div>
  </section>

  <section class="sec dark finalcta">
    <div class="container center">
      <h2>Rendez du temps à vos bénévoles.</h2>
      <p class="lead center">Essayez gratuitement, ou laissez-nous vous faire une démo sur votre club.</p>
      <div class="ctas center"><a class="btn-primary" href="/demo">Demander une démo</a><a class="btn-ghost" href="/tarifs">Voir les tarifs</a></div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .container { max-width: var(--maxw); margin: 0 auto; padding: 0 40px; }
  .sec { padding: 90px 0; }
  .dark { background: var(--navy); color: #fff; }
  .light { background: var(--cloud); }
  h2 { font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 42px; line-height: 1.07; letter-spacing: -.02em; margin: 0; }
  .eyebrow2 { font-weight: 600; font-size: 15.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--orange); margin-bottom: 14px; }
  .lead { font-size: 21px; line-height: 1.6; color: var(--muted); max-width: 640px; }
  .dark .lead { color: #aeb8c7; }
  .center { text-align: center; } .center.lead, .lead.center { margin-left: auto; margin-right: auto; }
  .mb { margin-bottom: 48px; }
  .btn-primary { display: inline-block; background: var(--orange); color: #fff; font-weight: 600; font-size: 17px; padding: 15px 26px; border-radius: 12px; text-decoration: none; }
  .btn-ghost { display: inline-block; border: 1px solid rgba(255,255,255,.3); color: #fff; font-weight: 600; font-size: 17px; padding: 15px 24px; border-radius: 12px; text-decoration: none; }
  .ib { width: 48px; height: 48px; border-radius: 12px; background: var(--orange-soft); display: flex; align-items: center; justify-content: center; }

  /* ---------- LES 3 THÈMES ---------- */
  .themes-intro .mb { margin-bottom: 40px; }
  .tnav { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .tnav-item { display: block; background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 24px 26px; text-decoration: none; color: inherit; transition: transform .15s, box-shadow .15s, border-color .15s; }
  .tnav-item:hover { transform: translateY(-3px); box-shadow: 0 20px 40px -24px rgba(13,30,53,.3); border-color: var(--orange); }
  .tnum { display: block; font-family: "JetBrains Mono", monospace; font-weight: 700; font-size: 14px; color: var(--orange); margin-bottom: 10px; }
  .tverbe { display: block; font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 26px; letter-spacing: -.01em; margin-bottom: 4px; }
  .tsur { display: block; font-size: 16px; color: var(--muted); line-height: 1.45; }

  .theme { scroll-margin-top: 80px; }
  .trow { display: grid; grid-template-columns: 1.02fr .98fr; gap: 58px; align-items: center; }
  .trow.rev .tcol { order: 2; } .trow.rev .tvis { order: 1; }
  .tbadge { display: inline-flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--orange); margin-bottom: 14px; }
  .tbadge span { font-family: "JetBrains Mono", monospace; background: var(--orange-soft); padding: 3px 9px; border-radius: 999px; letter-spacing: 0; }
  .th2 { font-size: 44px; margin-bottom: 14px; }
  .th2 .dot { color: var(--orange); }
  .tbesoin { margin: 0 0 26px; }
  .tfeats { display: flex; flex-direction: column; gap: 14px; }
  .tfeat { display: flex; gap: 13px; align-items: flex-start; }
  .tck { width: 30px; height: 30px; border-radius: 9px; background: var(--orange-soft); display: flex; align-items: center; justify-content: center; flex: none; }
  .tfeat b { display: block; font-family: "Gabarito", sans-serif; font-weight: 700; font-size: 17px; }
  /* NB : `.tfeat span` attraperait aussi `.tck` et écraserait son display:flex. */
  .tfeat div span { display: block; font-size: 16px; color: var(--muted); line-height: 1.5; margin-top: 2px; }

  /* visuels des thèmes */
  .vcard { background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 22px; box-shadow: 0 26px 54px -30px rgba(13,30,53,.4); }
  .vhead { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; font-weight: 700; font-size: 16px; }
  .vtag { font-size: 12px; font-weight: 700; color: var(--orange); background: var(--orange-soft); padding: 4px 10px; border-radius: 999px; }
  .vtag.live { color: var(--good); background: #e6f6ee; }
  .vstep { display: flex; align-items: center; gap: 11px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 11px; margin-bottom: 9px; font-size: 15.5px; }
  .vstep i { width: 9px; height: 9px; border-radius: 50%; background: var(--good); flex: none; }
  .vstep b { margin-left: auto; font-weight: 700; }
  .vfoot { font-size: 14px; color: var(--muted); margin-top: 14px; padding-top: 13px; border-top: 1px solid var(--line); }
  .vfoot b { color: var(--navy); }
  .vkpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 14px; }
  .vkpis > div { background: var(--cloud); border-radius: 11px; padding: 12px 13px; }
  .vkpis span { display: block; font-size: 12.5px; color: var(--muted); margin-bottom: 4px; }
  .vkpis b { font-family: "JetBrains Mono", monospace; font-weight: 700; font-size: 19px; }
  .vkpis em { display: block; font-style: normal; font-family: "JetBrains Mono", monospace; font-size: 12px; font-weight: 600; color: var(--good); margin-top: 3px; }
  .vnotif { display: flex; gap: 12px; align-items: flex-start; padding: 13px 14px; border: 1px solid var(--line); border-radius: 11px; margin-bottom: 9px; }
  .vdot { width: 9px; height: 9px; border-radius: 50%; background: var(--good); flex: none; margin-top: 6px; }
  .vdot.o { background: var(--orange); }
  .vnotif b { display: block; font-size: 15.5px; font-weight: 700; }
  .vnotif span { display: block; font-size: 14px; color: var(--muted); margin-top: 2px; }

  .hero { position: relative; background: var(--navy); color: #fff; padding: 0 0 84px; overflow: hidden; }
  .hero::before { content: ""; position: absolute; inset: 0; background-image: radial-gradient(rgba(255,255,255,.05) 1px, transparent 1px); background-size: 24px 24px; opacity: .7; }
  .hero::after { content: ""; position: absolute; width: 760px; height: 760px; right: -200px; top: -280px; background: radial-gradient(circle, rgba(240,122,32,.18), transparent 62%); }
  .hero-body { position: relative; z-index: 1; padding-top: 40px; }
  .hgrid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 46px; align-items: center; }
  .crumb { font-size: 15.5px; color: #8595ac; margin-bottom: 16px; } .crumb b { color: #c7d2e0; }
  .eyebrow { font-weight: 600; font-size: 15.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--orange); margin-bottom: 14px; }
  h1 { font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 55px; line-height: 1.04; letter-spacing: -.02em; margin: 0 0 20px; }
  h1 .dot { color: var(--orange); }
  .hsub { font-size: 21px; line-height: 1.58; color: #aeb8c7; max-width: 520px; margin: 0 0 28px; }
  .ctas { display: flex; gap: 14px; }

  .clubpanel { background: #fff; border-radius: 20px; padding: 22px; box-shadow: 0 40px 80px -24px rgba(0,0,0,.5); color: var(--navy); }
  .cp-head { display: flex; align-items: center; gap: 12px; padding-bottom: 16px; border-bottom: 1px solid var(--line); margin-bottom: 16px; }
  .cp-logo { width: 38px; height: 38px; border-radius: 10px; background: var(--navy); color: #fff; display: flex; align-items: center; justify-content: center; font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 20px; }
  .cp-head .n { font-weight: 700; font-size: 17px; } .cp-head .s { font-size: 13px; color: var(--muted); }
  .cp-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px; }
  .cp-stat { background: var(--cloud); border-radius: 12px; padding: 14px; }
  .cp-stat .k { font-size: 13px; color: var(--muted); margin-bottom: 5px; }
  .cp-stat .v { font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 26px; }
  .cp-stat .v small { font-family: "Inter", sans-serif; font-size: 13px; font-weight: 600; color: var(--good); margin-left: 4px; }
  .cp-bar { margin-bottom: 16px; }
  .cp-bar .lab { display: flex; justify-content: space-between; font-size: 13.5px; color: var(--muted); margin-bottom: 6px; } .cp-bar .lab b { color: var(--navy); }
  .cp-track { height: 8px; border-radius: 999px; background: var(--line); overflow: hidden; }
  .cp-track i { display: block; height: 100%; width: 86%; background: var(--good); border-radius: 999px; }
  .cp-btn { text-align: center; background: var(--orange); color: #fff; font-weight: 600; font-size: 16px; padding: 12px; border-radius: 10px; }



  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; margin-top: 44px; }
  .step { position: relative; padding: 0 22px; }
  .step:not(:last-child)::after { content: ""; position: absolute; top: 22px; right: 0; left: 56px; height: 2px; background: rgba(255,255,255,.15); }
  .step .num { width: 44px; height: 44px; border-radius: 50%; background: rgba(240,122,32,.16); border: 1px solid rgba(240,122,32,.5); color: var(--orange); display: flex; align-items: center; justify-content: center; font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 20px; margin-bottom: 16px; }
  .step h4 { font-family: "Gabarito", sans-serif; font-weight: 700; font-size: 19px; margin: 0 0 6px; }
  .step p { font-size: 16px; color: #aeb8c7; line-height: 1.5; margin: 0; }

  .quote { max-width: 820px; text-align: center; }
  .quote .big { font-family: "Gabarito", sans-serif; font-weight: 700; font-size: 31px; line-height: 1.3; letter-spacing: -.01em; margin: 8px 0 24px; }
  .quote .who { font-size: 16.5px; color: var(--muted); }
  .quote .who b { color: var(--navy); }

  .finalcta { text-align: center; } .finalcta h2 { font-size: 46px; margin-bottom: 14px; } .finalcta .ctas { justify-content: center; margin-top: 26px; }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 960px) {
    .hgrid { grid-template-columns: 1fr; gap: 36px; }
    .tnav { grid-template-columns: 1fr; }
    .trow { grid-template-columns: 1fr; gap: 34px; }
    .trow.rev .tcol { order: 1; } .trow.rev .tvis { order: 2; }
    .th2 { font-size: 36px; }
    h1 { font-size: 46px; }
    .steps { grid-template-columns: repeat(2, 1fr); gap: 28px 18px; }
    .step { padding: 0; }
    .step:not(:last-child)::after { display: none; }
  }
  @media (max-width: 620px) {
    .container { padding: 0 20px; }
    .sec { padding: 56px 0; }
    .hero { padding-bottom: 56px; }
    h1 { font-size: 35px; }
    h2 { font-size: 28px; }
    .hsub, .lead { font-size: 21px; }
    .ctas { flex-direction: column; align-items: stretch; }
    .btn-primary, .btn-ghost { text-align: center; }

    .steps { grid-template-columns: 1fr; }
    .quote .big { font-size: 23px; }
    .finalcta h2 { font-size: 33px; }
    .th2 { font-size: 30px; }
    .vkpis { grid-template-columns: 1fr; }
    .tnav-item { padding: 20px; }
    .tverbe { font-size: 23px; }
  }
</style>
