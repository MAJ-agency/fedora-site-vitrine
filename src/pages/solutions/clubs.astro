---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";

const enjeux = [
  { q: "Le papier et les tableurs partout", a: "Fiches d'inscription, chèques, fichiers Excel qui se perdent... Fedora centralise tout, à jour automatiquement." },
  { q: "Les relances de cotisations à la main", a: "Qui a payé ? Qui relancer ? Fedora suit les paiements et relance à votre place." },
  { q: "Les inscriptions éparpillées", a: "Mails, SMS, papiers... Vos adhérents s'inscrivent et paient en ligne, en quelques clics." },
  { q: "Du temps bénévole trop précieux", a: "Chaque heure compte. Fedora vous en rend, pour vous concentrer sur le sport et vos membres." },
];
const benefices = [
  { t: "Inscriptions en ligne", d: "Vos adhérents s'inscrivent et paient en quelques clics.", icon: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM19 8v6M22 11h-6"/>` },
  { t: "Cotisations & paiements", d: "CB, SEPA, chèque — suivis et relancés automatiquement.", icon: `<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/>` },
  { t: "Base membres à jour", d: "Un annuaire toujours propre, sans double saisie.", icon: `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM23 21v-2a4 4 0 0 0-3-3.87"/>` },
  { t: "Zéro courbe d'apprentissage", d: "Prise en main immédiate, même sans être à l'aise avec l'informatique.", icon: `<path d="M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>` },
];
const steps = [
  { t: "Choix de la formule", d: "L'adhérent sélectionne sa section, sa catégorie, ses options." },
  { t: "Infos & documents", d: "Coordonnées et certificat médical, importés une seule fois." },
  { t: "Paiement en ligne", d: "CB, SEPA ou paiement en plusieurs fois, sécurisé." },
  { t: "Licence délivrée", d: "La licence est émise automatiquement, dispo dans l'app." },
];
const modules = [
  { t: "Espace club", d: "Votre tableau de bord : membres, cotisations, échéances.", icon: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"/>` },
  { t: "Inscriptions & paiements", d: "Formulaires personnalisés, paiement en ligne, reçus auto.", icon: `<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/>` },
  { t: "Communication", d: "Messages ciblés à vos membres, sans intermédiaire.", icon: `<path d="M4 4h16v4H4zM4 12h10M4 17h7"/>` },
  { t: "Planning", d: "Créneaux, réservations et agenda partagé.", icon: `<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>` },
  { t: "App mobile", d: "Vos membres gardent leur licence et le club en poche.", icon: `<rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/>` },
  { t: "Support inclus", d: "Une équipe réactive et des guides, pour ne jamais bloquer.", icon: `<path d="M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16zM12 8v4l3 2"/>` },
];
const ckIcon = (i) => `<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="#F07A20" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${i}</svg>`;
---

<Layout title="Fedora pour les clubs — Gérez votre club simplement" description="Inscriptions, cotisations, licences, membres — tout au même endroit, tout simple. Pensé pour les bénévoles.">
  <section class="hero">
    <Nav />
    <div class="container hero-body">
      <div class="hgrid">
        <div>
          <div class="crumb">Solutions <b>›</b> Clubs</div>
          <div class="eyebrow">Pour les bénévoles de club</div>
          <h1>Gérez votre club sans y passer vos soirées<span class="dot">.</span></h1>
          <p class="hsub">Inscriptions, cotisations, licences, membres — tout au même endroit, tout simple. Fini le papier, les tableurs et les relances à la main.</p>
          <div class="ctas"><a class="btn-primary" href="/demo">Essayer gratuitement</a><a class="btn-ghost" href="/demo">Voir la démo</a></div>
        </div>
        <div class="clubpanel">
          <div class="cp-head"><div class="cp-logo">AP</div><div><div class="n">AS Ploërmel</div><div class="s">Espace club · saison 2025-26</div></div></div>
          <div class="cp-stats">
            <div class="cp-stat"><div class="k">Adhérents</div><div class="v">248 <small>+12</small></div></div>
            <div class="cp-stat"><div class="k">Encaissé</div><div class="v">8 680 €</div></div>
          </div>
          <div class="cp-bar"><div class="lab"><span>Cotisations à jour</span><b>214 / 248</b></div><div class="cp-track"><i></i></div></div>
          <div class="cp-btn">+ Nouvelle inscription</div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec light">
    <div class="container">
      <div class="eyebrow2">Le quotidien d'un bénévole</div>
      <h2>On connaît vos galères.</h2>
      <div class="enj">
        {enjeux.map((e, i) => (<div class="enjrow"><div class="no">{`0${i + 1}`}</div><div><div class="q">{e.q}</div><div class="a">{e.a}</div></div></div>))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="container">
      <div class="eyebrow2 center">Ce que ça change pour vous</div>
      <h2 class="center">Simple. Vraiment simple.</h2>
      <p class="lead center mb">Pensé pour des bénévoles, pas pour des informaticiens. Si vous savez remplir un formulaire, vous savez utiliser Fedora.</p>
      <div class="grid4">
        {benefices.map((b) => (<div class="bcard"><span class="ib" set:html={ckIcon(b.icon)} /><h3>{b.t}</h3><p>{b.d}</p></div>))}
      </div>
    </div>
  </section>

  <section class="sec dark">
    <div class="container">
      <div class="eyebrow2 center">L'adhésion en ligne</div>
      <h2 class="center">De l'inscription à la licence, en 3 minutes.</h2>
      <div class="steps">
        {steps.map((s, i) => (<div class="step"><div class="num">{i + 1}</div><h4>{s.t}</h4><p>{s.d}</p></div>))}
      </div>
    </div>
  </section>

  <section class="sec light">
    <div class="container">
      <div class="eyebrow2 center">Fait pour votre club</div>
      <h2 class="center">Tout ce qu'il faut, rien de superflu.</h2>
      <p class="lead center mb">Le socle licences, plus les outils du quotidien d'un club.</p>
      <div class="grid3">
        {modules.map((m) => (<div class="mod"><span class="ib" set:html={ckIcon(m.icon)} /><h4>{m.t}</h4><p>{m.d}</p></div>))}
      </div>
    </div>
  </section>

  <section class="sec dark">
    <div class="container quote">
      <div class="eyebrow2 center">Ils l'ont adopté</div>
      <div class="big">« Avant, je passais mes dimanches sur Excel à pointer les cotisations. Aujourd'hui, tout est à jour tout seul — je peux enfin m'occuper du club, pas de la paperasse. »</div>
      <div class="who"><b>Sophie L.</b> — Secrétaire, club de judo · 240 licenciés</div>
    </div>
  </section>

  <section class="sec dark finalcta">
    <div class="container center">
      <h2>Rendez du temps à vos bénévoles.</h2>
      <p class="lead center">Essayez gratuitement, ou laissez-nous vous faire une démo sur votre club.</p>
      <div class="ctas center"><a class="btn-primary" href="/demo">Essayer gratuitement</a><a class="btn-ghost" href="/demo">Voir la démo</a></div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .container { max-width: var(--maxw); margin: 0 auto; padding: 0 40px; }
  .sec { padding: 90px 0; }
  .dark { background: var(--navy); color: #fff; }
  .light { background: var(--cloud); }
  h2 { font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 38px; line-height: 1.07; letter-spacing: -.02em; margin: 0; }
  .eyebrow2 { font-weight: 600; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--orange); margin-bottom: 14px; }
  .lead { font-size: 18px; line-height: 1.6; color: var(--muted); max-width: 640px; }
  .dark .lead { color: #aeb8c7; }
  .center { text-align: center; } .center.lead, .lead.center { margin-left: auto; margin-right: auto; }
  .mb { margin-bottom: 48px; }
  .btn-primary { display: inline-block; background: var(--orange); color: #fff; font-weight: 600; font-size: 16px; padding: 15px 26px; border-radius: 12px; text-decoration: none; }
  .btn-ghost { display: inline-block; border: 1px solid rgba(255,255,255,.3); color: #fff; font-weight: 600; font-size: 16px; padding: 15px 24px; border-radius: 12px; text-decoration: none; }
  .ib { width: 48px; height: 48px; border-radius: 12px; background: var(--orange-soft); display: flex; align-items: center; justify-content: center; }

  .hero { position: relative; background: var(--navy); color: #fff; padding: 0 0 84px; overflow: hidden; }
  .hero::before { content: ""; position: absolute; inset: 0; background-image: radial-gradient(rgba(255,255,255,.05) 1px, transparent 1px); background-size: 24px 24px; opacity: .7; }
  .hero::after { content: ""; position: absolute; width: 760px; height: 760px; right: -200px; top: -280px; background: radial-gradient(circle, rgba(240,122,32,.18), transparent 62%); }
  .hero-body { position: relative; z-index: 1; padding-top: 40px; }
  .hgrid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 46px; align-items: center; }
  .crumb { font-size: 13px; color: #8595ac; margin-bottom: 16px; } .crumb b { color: #c7d2e0; }
  .eyebrow { font-weight: 600; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--orange); margin-bottom: 14px; }
  h1 { font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 50px; line-height: 1.04; letter-spacing: -.02em; margin: 0 0 20px; }
  h1 .dot { color: var(--orange); }
  .hsub { font-size: 18px; line-height: 1.58; color: #aeb8c7; max-width: 520px; margin: 0 0 28px; }
  .ctas { display: flex; gap: 14px; }

  .clubpanel { background: #fff; border-radius: 20px; padding: 22px; box-shadow: 0 40px 80px -24px rgba(0,0,0,.5); color: var(--navy); }
  .cp-head { display: flex; align-items: center; gap: 12px; padding-bottom: 16px; border-bottom: 1px solid var(--line); margin-bottom: 16px; }
  .cp-logo { width: 38px; height: 38px; border-radius: 10px; background: var(--navy); color: #fff; display: flex; align-items: center; justify-content: center; font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 18px; }
  .cp-head .n { font-weight: 700; font-size: 15px; } .cp-head .s { font-size: 12px; color: var(--muted); }
  .cp-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px; }
  .cp-stat { background: var(--cloud); border-radius: 12px; padding: 14px; }
  .cp-stat .k { font-size: 12px; color: var(--muted); margin-bottom: 5px; }
  .cp-stat .v { font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 24px; }
  .cp-stat .v small { font-family: "Inter", sans-serif; font-size: 12px; font-weight: 600; color: var(--good); margin-left: 4px; }
  .cp-bar { margin-bottom: 16px; }
  .cp-bar .lab { display: flex; justify-content: space-between; font-size: 12.5px; color: var(--muted); margin-bottom: 6px; } .cp-bar .lab b { color: var(--navy); }
  .cp-track { height: 8px; border-radius: 999px; background: var(--line); overflow: hidden; }
  .cp-track i { display: block; height: 100%; width: 86%; background: var(--good); border-radius: 999px; }
  .cp-btn { text-align: center; background: var(--orange); color: #fff; font-weight: 600; font-size: 14px; padding: 12px; border-radius: 10px; }

  .enj { display: flex; flex-direction: column; gap: 2px; margin-top: 32px; max-width: 820px; }
  .enjrow { display: flex; gap: 16px; align-items: flex-start; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .enjrow:last-child { border-bottom: none; }
  .enjrow .no { font-family: "JetBrains Mono", monospace; font-weight: 700; color: var(--orange); font-size: 14px; flex: none; width: 32px; padding-top: 2px; }
  .enjrow .q { font-weight: 600; font-size: 16px; margin-bottom: 3px; }
  .enjrow .a { font-size: 14.5px; color: var(--muted); line-height: 1.5; }

  .grid4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .bcard { background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 28px; }
  .bcard h3 { font-family: "Gabarito", sans-serif; font-weight: 700; font-size: 20px; margin: 16px 0 8px; }
  .bcard p { font-size: 14.5px; color: var(--muted); line-height: 1.5; }
  .mod { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 22px; }
  .mod h4 { font-family: "Gabarito", sans-serif; font-weight: 700; font-size: 17px; margin: 12px 0 5px; }
  .mod p { font-size: 13px; color: var(--muted); line-height: 1.45; }

  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; margin-top: 44px; }
  .step { position: relative; padding: 0 22px; }
  .step:not(:last-child)::after { content: ""; position: absolute; top: 22px; right: 0; left: 56px; height: 2px; background: rgba(255,255,255,.15); }
  .step .num { width: 44px; height: 44px; border-radius: 50%; background: rgba(240,122,32,.16); border: 1px solid rgba(240,122,32,.5); color: var(--orange); display: flex; align-items: center; justify-content: center; font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 18px; margin-bottom: 16px; }
  .step h4 { font-family: "Gabarito", sans-serif; font-weight: 700; font-size: 17px; margin: 0 0 6px; }
  .step p { font-size: 13.5px; color: #aeb8c7; line-height: 1.5; margin: 0; }

  .quote { max-width: 820px; text-align: center; }
  .quote .big { font-family: "Gabarito", sans-serif; font-weight: 700; font-size: 28px; line-height: 1.3; letter-spacing: -.01em; margin: 8px 0 24px; }
  .quote .who { font-size: 14.5px; color: #aeb8c7; } .quote .who b { color: #fff; }

  .finalcta { text-align: center; } .finalcta h2 { font-size: 42px; margin-bottom: 14px; } .finalcta .ctas { justify-content: center; margin-top: 26px; }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 960px) {
    .hgrid { grid-template-columns: 1fr; gap: 36px; }
    h1 { font-size: 42px; }
    .grid4 { grid-template-columns: repeat(2, 1fr); }
    .grid3 { grid-template-columns: repeat(2, 1fr); }
    .steps { grid-template-columns: repeat(2, 1fr); gap: 28px 18px; }
    .step { padding: 0; }
    .step:not(:last-child)::after { display: none; }
  }
  @media (max-width: 620px) {
    .container { padding: 0 20px; }
    .sec { padding: 56px 0; }
    .hero { padding-bottom: 56px; }
    h1 { font-size: 32px; }
    h2 { font-size: 26px; }
    .hsub, .lead { font-size: 16px; }
    .ctas { flex-direction: column; align-items: stretch; }
    .btn-primary, .btn-ghost { text-align: center; }
    .grid4, .grid3 { grid-template-columns: 1fr; }
    .steps { grid-template-columns: 1fr; }
    .quote .big { font-size: 21px; }
    .finalcta h2 { font-size: 30px; }
  }
</style>
