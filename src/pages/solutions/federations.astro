---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";

// Les 3 thèmes stratégiques = le mojo Fedora, développé pour l'échelon fédéral.
const themes = [
  {
    verbe: "Digitalisez",
    sur: "Moderniser et gagner en efficacité",
    besoin:
      "Sortir du papier et des tableurs, fluidifier vos processus et faire gagner du temps à tout le réseau — du siège jusqu'au bénévole de club.",
    features: [
      { t: "Licences & affiliations en ligne", d: "Des parcours conformes à votre réglementation, de bout en bout." },
      { t: "Paiements multi-canaux", d: "CB, SEPA, chèque, espèces, Pass'Sport — encaissés et rapprochés." },
      { t: "Formations & diplômes", d: "Sessions, certifications et recyclages de vos officiels, dématérialisés." },
      { t: "GED, signatures & votes", d: "Documents signés, assemblées générales et élections en ligne." },
    ],
    visuel: "flow",
  },
  {
    verbe: "Pilotez",
    sur: "Centraliser, analyser, décider",
    besoin:
      "Disposer d'une information consolidée et fiable pour piloter votre activité, arbitrer en connaissance de cause et rendre des comptes à vos tutelles.",
    features: [
      { t: "Une base unique, du siège au club", d: "Arborescence fédérale complète, chaque échelon sur son périmètre." },
      { t: "Analyse & aide à la décision", d: "Indicateurs par ligue, comité, club et discipline, saison après saison." },
      { t: "Finances & reversements", d: "Quote-parts calculées et réparties automatiquement, à l'euro près." },
      { t: "Conformité & exports institutionnels", d: "Rapports normés et traçabilité, prêts pour vos tutelles." },
    ],
    visuel: "kpi",
  },
  {
    verbe: "Développez",
    sur: "Faire grandir la pratique et le réseau",
    besoin:
      "Fidéliser et attirer licenciés et clubs, animer la vie sportive et proposer des outils à la hauteur de leurs attentes.",
    features: [
      { t: "Compétitions", d: "Calendrier fédéral, engagements par club et classements officiels." },
      { t: "Communication ciblée", d: "Informez par échelon, catégorie ou événement, sans intermédiaire." },
      { t: "App mobile licencié", d: "Licence numérique, QR code, agenda et résultats dans la poche." },
      { t: "Espace club & inscriptions", d: "Des outils modernes qui simplifient la vie de vos bénévoles." },
    ],
    visuel: "mobile",
  },
];
const secu = [
  { t: "2FA & RBAC", d: "Double authentification, gestion fine des rôles par échelon.", icon: `<rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>` },
  { t: "Hébergement HDS", d: "100 % français, certifié, sur 2 sites en France.", icon: `<path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z"/>` },
  { t: "Option SecNumCloud", d: "Zone qualifiée ANSSI — souveraineté maximale.", icon: `<path d="M12 2l3 6 6 .5-4.5 4 1.5 6L12 15l-6 3.5 1.5-6L3 8.5 9 8z"/>` },
  { t: "Audit continu", d: "Surveillance externe certifiée + détection des vulnérabilités.", icon: `<circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/>` },
];
const ckIcon = (i) => `<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="#F07A20" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${i}</svg>`;
// Ancres sans accent : "Développez" -> "developpez" (une URL accentuée est fragile).
const slug = (s) => s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");
---

<Layout title="Fedora pour les fédérations — Pilotez tout votre réseau" description="Une vue consolidée sur chaque ligue, comité et club. Reversements automatisés, conformité assurée et profondeur pour votre staff fédéral.">
  <!-- HERO -->
  <section class="hero">
    <Nav />
    <div class="container hero-body">
      <div class="hgrid">
        <div>
          <div class="crumb">Solutions <b>›</b> Fédérations, Ligues &amp; Comités</div>
          <div class="eyebrow">Pour le staff fédéral</div>
          <h1>Pilotez toute votre fédération, du siège au terrain<span class="dot">.</span></h1>
          <p class="hsub">Une vue consolidée sur chaque ligue, comité et club. Les reversements automatisés, la conformité assurée, et la profondeur qu'attend votre équipe.</p>
          <div class="ctas"><a class="btn-primary" href="/demo">Demander une démo</a><a class="btn-ghost" href="/produit/socle">Voir les fonctionnalités</a></div>
        </div>
        <div class="pulse">
          <div class="ph">
            <span class="pt">Le pouls de votre fédération</span>
            <span class="live"><i></i> En direct</span>
          </div>

          <div class="pmain">
            <div class="pnum">348 210<span class="pgrow">▲ 8,2 %</span></div>
            <div class="plab">licences délivrées cette saison</div>
          </div>

          <svg class="pchart" viewBox="0 0 340 96" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <linearGradient id="pulseG" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#F07A20" stop-opacity=".45"></stop>
                <stop offset="1" stop-color="#F07A20" stop-opacity="0"></stop>
              </linearGradient>
            </defs>
            <path d="M0,80 L38,74 L76,66 L114,68 L152,54 L190,46 L228,40 L266,28 L304,20 L340,8 L340,96 L0,96 Z" fill="url(#pulseG)"></path>
            <path d="M0,80 L38,74 L76,66 L114,68 L152,54 L190,46 L228,40 L266,28 L304,20 L340,8" fill="none" stroke="#F07A20" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
            <circle cx="340" cy="8" r="4.5" fill="#F07A20"></circle>
          </svg>
          <div class="pseasons"><span>2021</span><span>2022</span><span>2023</span><span>2024</span><span>2025</span></div>

          <div class="pfeed">
            <div class="pev"><i class="g"></i><span class="pl">Licence émise · <b>Judo Club Rennes</b></span><span class="pw">à l'instant</span></div>
            <div class="pev"><i class="o"></i><span class="pl">Reversement réparti · <b>Ligue Bretagne</b></span><span class="pw">+ 6,50 €</span></div>
            <div class="pev"><i class="g"></i><span class="pl">Affiliation validée · <b>AS Ploërmel</b></span><span class="pw">2 min</span></div>
          </div>

          <div class="pfoot"><b>1 402 clubs</b> et <b>12 ligues</b> alimentent ces chiffres, en continu.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- INTRO DES 3 THÈMES -->
  <section class="sec light themes-intro">
    <div class="container">
      <div class="eyebrow2 center">Vos enjeux</div>
      <h2 class="center">Trois enjeux, une seule plateforme.</h2>
      <p class="lead center mb">Digitaliser vos processus, piloter votre réseau sur des chiffres fiables, et développer la pratique — Fedora couvre le cycle complet d'une fédération.</p>
      <div class="tnav">
        {themes.map((t, i) => (
          <a class="tnav-item" href={`#${slug(t.verbe)}`}>
            <span class="tnum">{`0${i + 1}`}</span>
            <span class="tverbe">{t.verbe}</span>
            <span class="tsur">{t.sur}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- LES 3 THÈMES DÉVELOPPÉS -->
  {themes.map((t, i) => (
    <section class={`sec theme ${i % 2 === 1 ? "light" : ""}`} id={slug(t.verbe)}>
      <div class="container">
        <div class={`trow ${i % 2 === 1 ? "rev" : ""}`}>
          <div class="tcol">
            <div class="tbadge"><span>{`0${i + 1}`}</span> {t.sur}</div>
            <h2 class="th2">{t.verbe}<span class="dot">.</span></h2>
            <p class="lead tbesoin">{t.besoin}</p>
            <div class="tfeats">
              {t.features.map((f) => (
                <div class="tfeat">
                  <span class="tck"><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="#F07A20" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"></path></svg></span>
                  <div><b>{f.t}</b><span>{f.d}</span></div>
                </div>
              ))}
            </div>
          </div>

          <div class="tvis">
            {t.visuel === "flow" && (
              <div class="vcard">
                <div class="vhead"><span>Prise de licence en ligne</span><span class="vtag">Sans papier</span></div>
                <div class="vstep done"><i></i> Choix de la formule <b>Compétition</b></div>
                <div class="vstep done"><i></i> Questionnaire santé <b>validé</b></div>
                <div class="vstep done"><i></i> Paiement <b>180,00 €</b></div>
                <div class="vstep live"><i></i> Licence émise <b>automatiquement</b></div>
                <div class="vfoot">Délai moyen constaté : <b>3 min</b> au lieu de plusieurs jours</div>
              </div>
            )}
            {t.visuel === "kpi" && (
              <div class="vcard">
                <div class="vhead"><span>Tableau de bord fédéral</span><span class="vtag live">● En direct</span></div>
                <div class="vkpis">
                  <div><span>Licences</span><b>12 480</b><em>▲ 8,2 %</em></div>
                  <div><span>Clubs affiliés</span><b>342</b><em>▲ 12</em></div>
                  <div><span>Recettes</span><b>1,24 M€</b><em>saison</em></div>
                </div>
                <svg class="varea" viewBox="0 0 320 72" preserveAspectRatio="none">
                  <defs><linearGradient id={`tg${i}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F07A20" stop-opacity=".38"></stop><stop offset="1" stop-color="#F07A20" stop-opacity="0"></stop></linearGradient></defs>
                  <path d="M0,60 L36,52 L72,56 L108,40 L144,46 L180,32 L216,36 L252,20 L288,15 L320,7 L320,72 L0,72 Z" fill={`url(#tg${i})`}></path>
                  <path d="M0,60 L36,52 L72,56 L108,40 L144,46 L180,32 L216,36 L252,20 L288,15 L320,7" fill="none" stroke="#F07A20" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                <div class="vfoot">Filtrable par ligue, comité, club et discipline</div>
              </div>
            )}
            {t.visuel === "mobile" && (
              <div class="vcard">
                <div class="vhead"><span>Communication & compétitions</span><span class="vtag">Module</span></div>
                <div class="vnotif"><span class="vdot"></span><div><b>Convocation — Championnat régional</b><span>Envoyée à 412 licenciés · Ligue Bretagne</span></div></div>
                <div class="vnotif"><span class="vdot o"></span><div><b>Classement mis à jour</b><span>Publié automatiquement après saisie des résultats</span></div></div>
                <div class="vnotif"><span class="vdot"></span><div><b>Ouverture des engagements</b><span>Notifiée aux 342 clubs affiliés</span></div></div>
                <div class="vfoot">Directement dans l'app mobile de vos licenciés</div>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- REVERSEMENTS -->
  <section class="sec dark">
    <div class="container">
      <div class="revwrap">
        <div>
          <div class="eyebrow2">Zoom — Le cas le plus complexe</div>
          <h2>Ce qui se passe quand une licence est vendue.</h2>
          <p class="lead">Derrière chaque licence vendue se cache le calcul le plus fastidieux de la vie fédérale : répartir la quote-part de chaque échelon, sans erreur ni oubli. Fedora s'en charge automatiquement, à l'euro près et de façon traçable.</p>
        </div>
        <div class="revcard">
          <div class="flow">
            <div class="fnode"><span class="fl">Licence vendue par le club</span><span class="fp">35,00 €</span></div>
            <div class="farrow">↓</div>
            <div class="fnode"><span class="fl">Part Fédération</span><span class="fp">12,00 €</span></div>
            <div class="fnode"><span class="fl">Part Ligue</span><span class="fp">6,50 €</span></div>
            <div class="fnode"><span class="fl">Part Comité</span><span class="fp">4,00 €</span></div>
            <div class="fnode"><span class="fl">Reste au Club</span><span class="fp">12,50 €</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECURITE -->
  <section class="sec light">
    <div class="container">
      <div class="eyebrow2 center">Sécurité &amp; souveraineté</div>
      <h2 class="center">Un niveau d'exigence à la hauteur d'une institution.</h2>
      <div class="grid4 secgrid">
        {secu.map((s) => (
          <div class="scard"><span class="ib" set:html={ckIcon(s.icon)} /><h4>{s.t}</h4><p>{s.d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="sec dark finalcta">
    <div class="container center">
      <h2>Voyons ce que Fedora ferait pour votre fédération.</h2>
      <p class="lead center">Une démo sur vos vrais cas d'usage, et un chiffrage adapté à votre volume de licences.</p>
      <div class="ctas center"><a class="btn-primary" href="/demo">Demander une démo</a><a class="btn-ghost" href="/demo">Nous contacter</a></div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .container { max-width: var(--maxw); margin: 0 auto; padding: 0 40px; }
  .sec { padding: 90px 0; }
  .dark { background: var(--navy); color: #fff; }
  .light { background: var(--cloud); }
  h2 { font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 42px; line-height: 1.07; letter-spacing: -.02em; margin: 0; }
  .eyebrow2 { font-weight: 600; font-size: 15.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--orange); margin-bottom: 14px; }
  .lead { font-size: 21px; line-height: 1.6; color: var(--muted); max-width: 640px; }
  .dark .lead { color: #aeb8c7; }
  .center { text-align: center; } .center.lead, .lead.center { margin-left: auto; margin-right: auto; }
  .mb { margin-bottom: 48px; }
  .btn-primary { display: inline-block; background: var(--orange); color: #fff; font-weight: 600; font-size: 17px; padding: 15px 26px; border-radius: 12px; text-decoration: none; }
  .btn-ghost { display: inline-block; border: 1px solid rgba(255,255,255,.3); color: #fff; font-weight: 600; font-size: 17px; padding: 15px 24px; border-radius: 12px; text-decoration: none; }
  .ib { width: 48px; height: 48px; border-radius: 12px; background: var(--orange-soft); display: flex; align-items: center; justify-content: center; }

  /* hero */
  .hero { position: relative; background: var(--navy); color: #fff; padding: 0 0 84px; overflow: hidden; }
  .hero::before { content: ""; position: absolute; inset: 0; background-image: radial-gradient(rgba(255,255,255,.05) 1px, transparent 1px); background-size: 24px 24px; opacity: .7; }
  .hero::after { content: ""; position: absolute; width: 760px; height: 760px; right: -200px; top: -280px; background: radial-gradient(circle, rgba(240,122,32,.18), transparent 62%); }
  .hero-body { position: relative; z-index: 1; padding-top: 40px; }
  .hgrid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 46px; align-items: center; }
  .crumb { font-size: 15.5px; color: #8595ac; margin-bottom: 16px; } .crumb b { color: #c7d2e0; }
  .eyebrow { font-weight: 600; font-size: 15.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--orange); margin-bottom: 14px; }
  h1 { font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 55px; line-height: 1.04; letter-spacing: -.02em; margin: 0 0 20px; }
  h1 .dot { color: var(--orange); }
  .hsub { font-size: 21px; line-height: 1.58; color: #aeb8c7; max-width: 520px; margin: 0 0 28px; }
  .ctas { display: flex; gap: 14px; }

  /* Hero — « Le pouls du réseau » */
  .pulse { background: linear-gradient(180deg, #16305a, #122444); border: 1px solid rgba(255,255,255,.1); border-radius: 20px; padding: 24px; box-shadow: 0 40px 80px -24px rgba(0,0,0,.6); }
  .ph { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
  .ph .pt { font-weight: 600; font-size: 16px; }
  .live { display: inline-flex; align-items: center; gap: 7px; font-size: 12px; font-weight: 600; color: var(--mint); background: rgba(52,211,153,.12); border: 1px solid rgba(52,211,153,.3); padding: 5px 10px; border-radius: 999px; }
  .live i { width: 7px; height: 7px; border-radius: 50%; background: var(--mint); }
  .pnum { font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 46px; line-height: 1; letter-spacing: -.02em; display: flex; align-items: baseline; gap: 12px; }
  .pgrow { font-family: "JetBrains Mono", monospace; font-weight: 700; font-size: 16px; color: var(--mint); letter-spacing: 0; }
  .plab { font-size: 15px; color: #9fb0c7; margin-top: 6px; }
  .pchart { width: 100%; height: 96px; display: block; margin-top: 14px; }
  .pseasons { display: flex; justify-content: space-between; font-family: "JetBrains Mono", monospace; font-size: 11.5px; color: #7c8aa3; padding: 6px 2px 0; border-top: 1px solid rgba(255,255,255,.08); }
  .pfeed { margin-top: 18px; display: flex; flex-direction: column; gap: 8px; }
  .pev { display: flex; align-items: center; gap: 11px; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.07); border-radius: 11px; padding: 11px 13px; font-size: 14.5px; color: #c7d2e0; }
  .pev i { width: 8px; height: 8px; border-radius: 50%; flex: none; }
  .pev i.g { background: var(--mint); } .pev i.o { background: var(--orange); }
  .pev b { color: #fff; font-weight: 600; }
  .pev .pw { margin-left: auto; font-family: "JetBrains Mono", monospace; font-size: 12.5px; color: #9fb0c7; white-space: nowrap; }
  .pfoot { font-size: 13.5px; color: #9fb0c7; margin-top: 16px; padding-top: 14px; border-top: 1px solid rgba(255,255,255,.08); }
  .pfoot b { color: #fff; font-weight: 600; }

  /* enjeux */
  .enj { display: flex; flex-direction: column; gap: 2px; margin-top: 32px; max-width: 820px; }
  .enjrow { display: flex; gap: 16px; align-items: flex-start; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .enjrow:last-child { border-bottom: none; }
  .enjrow .no { font-family: "JetBrains Mono", monospace; font-weight: 700; color: var(--orange); font-size: 16px; flex: none; width: 32px; padding-top: 2px; }
  .enjrow .q { font-weight: 600; font-size: 17px; margin-bottom: 3px; }
  .enjrow .a { font-size: 16.5px; color: var(--muted); line-height: 1.5; }

  /* benefices + modules + secu */
  .grid4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  .secgrid { margin-top: 40px; }
  .scard h4 { font-family: "Gabarito", sans-serif; font-weight: 700; font-size: 17px; margin: 14px 0 7px; }
  .scard { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 24px; }
  .scard p { font-size: 16.5px; color: var(--muted); line-height: 1.5; }
  .scard .ib { background: var(--orange-soft); }

  /* reversements */
  .revwrap { display: grid; grid-template-columns: .9fr 1.1fr; gap: 48px; align-items: center; }
  .revcard { background: var(--navy-soft); border: 1px solid rgba(255,255,255,.1); border-radius: 18px; padding: 26px; }
  .flow { display: flex; flex-direction: column; gap: 10px; }
  .fnode { display: flex; align-items: center; gap: 12px; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08); border-radius: 12px; padding: 13px 16px; }
  .fnode .fl { font-size: 16px; font-weight: 600; }
  .fnode .fp { margin-left: auto; font-family: "JetBrains Mono", monospace; font-weight: 700; color: var(--orange); font-size: 16px; }
  .farrow { text-align: center; color: #5f6e86; font-size: 17px; line-height: .6; }

  .finalcta { text-align: center; }
  .finalcta h2 { font-size: 46px; margin-bottom: 14px; }
  .finalcta .ctas { justify-content: center; margin-top: 26px; }

  /* ---------- LES 3 THÈMES ---------- */
  .themes-intro .mb { margin-bottom: 40px; }
  .tnav { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .tnav-item { display: block; background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 24px 26px; text-decoration: none; color: inherit; transition: transform .15s, box-shadow .15s, border-color .15s; }
  .tnav-item:hover { transform: translateY(-3px); box-shadow: 0 20px 40px -24px rgba(13,30,53,.3); border-color: var(--orange); }
  .tnum { display: block; font-family: "JetBrains Mono", monospace; font-weight: 700; font-size: 14px; color: var(--orange); margin-bottom: 10px; }
  .tverbe { display: block; font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 26px; letter-spacing: -.01em; margin-bottom: 4px; }
  .tsur { display: block; font-size: 16px; color: var(--muted); line-height: 1.45; }

  .theme { scroll-margin-top: 80px; }
  .trow { display: grid; grid-template-columns: 1.02fr .98fr; gap: 58px; align-items: center; }
  .trow.rev .tcol { order: 2; } .trow.rev .tvis { order: 1; }
  .tbadge { display: inline-flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--orange); margin-bottom: 14px; }
  .tbadge span { font-family: "JetBrains Mono", monospace; background: var(--orange-soft); padding: 3px 9px; border-radius: 999px; letter-spacing: 0; }
  .th2 { font-size: 44px; margin-bottom: 14px; }
  .th2 .dot { color: var(--orange); }
  .tbesoin { margin: 0 0 26px; }
  .tfeats { display: flex; flex-direction: column; gap: 14px; }
  .tfeat { display: flex; gap: 13px; align-items: flex-start; }
  .tck { width: 30px; height: 30px; border-radius: 9px; background: var(--orange-soft); display: flex; align-items: center; justify-content: center; flex: none; }
  .tfeat b { display: block; font-family: "Gabarito", sans-serif; font-weight: 700; font-size: 17px; }
  /* NB : cibler `.tfeat span` attraperait aussi `.tck` (l'icône) et écraserait
     son display:flex — d'où le centrage cassé. On ne vise que le span de texte. */
