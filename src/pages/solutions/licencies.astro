---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";

const benefices = [
  { t: "Licence numérique & QR", d: "Toujours dans la poche, vérifiable en un scan.", icon: `<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3M20 20h.01M17 20h.01M20 17h.01"/>` },
  { t: "Renouvellement 1 clic", d: "Reprenez votre licence en quelques secondes, chaque saison.", icon: `<path d="M23 4v6h-6M1 20v-6h6M3.5 9a9 9 0 0 1 14.9-3.4L23 10M1 14l4.6 4.4A9 9 0 0 0 20.5 15"/>` },
  { t: "Agenda & inscriptions", d: "Entraînements, événements, compétitions — inscrivez-vous en direct.", icon: `<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>` },
  { t: "Infos du club", d: "Notifications, résultats et messages, sans rien manquer.", icon: `<path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0"/>` },
];
const modules = [
  { t: "Licence numérique", d: "QR code, statut, historique de vos licences.", icon: `<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h7v7h-7z"/>` },
  { t: "Calendrier & résultats", d: "Prochaines échéances, convocations, scores.", icon: `<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>` },
  { t: "Paiement & renouvellement", d: "Réglez cotisations et options depuis l'app.", icon: `<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/>` },
  { t: "Notifications", d: "Messages du club et rappels, au bon moment.", icon: `<path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/>` },
  { t: "Famille & enfants", d: "Gérez les licences de toute la famille depuis un compte.", icon: `<path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M10 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"/>` },
  { t: "Documents", d: "Certificat médical, attestations, à jour et accessibles.", icon: `<path d="M12 2l3 6 6 .5-4.5 4 1.5 6L12 15l-6 3.5 1.5-6L3 8.5 9 8z"/>` },
];
const ckIcon = (i) => `<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="#F07A20" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${i}</svg>`;
const apple = `<svg viewBox="0 0 24 24" width="18" height="18" fill="#fff"><path d="M17 3c.1 1.3-.4 2.5-1.2 3.4-.8.9-2 1.6-3.2 1.5-.1-1.2.5-2.5 1.2-3.3.8-.9 2.1-1.5 3.2-1.6zM20 17c-.5 1.2-.8 1.7-1.5 2.7-.9 1.4-2.3 3.2-3.9 3.2-1.5 0-1.9-1-3.9-1-2 0-2.4 1-3.9 1-1.6 0-2.9-1.6-3.9-3C.7 18.1.4 14 2 11.4c.9-1.5 2.5-2.4 4-2.4 1.5 0 2.5 1 3.8 1 1.2 0 2-1 3.8-1 1.3 0 2.7.7 3.7 2-3.2 1.8-2.7 6.4.9 6z"/></svg>`;
const gplay = `<svg viewBox="0 0 24 24" width="18" height="18" fill="#fff"><path d="M3 3l13 9-13 9zM3 3l10.5 9L3 21z"/></svg>`;
---

<Layout title="Fedora pour les licenciés — Votre licence dans la poche" description="Licence numérique, QR code, renouvellement en un clic, agenda et résultats de votre club — tout dans l'app.">
  <section class="hero">
    <Nav />
    <div class="container hero-body">
      <div class="hgrid">
        <div>
          <div class="crumb">Solutions <b>›</b> Licenciés</div>
          <div class="eyebrow">Pour les pratiquants</div>
          <h1>Votre licence, toujours dans votre poche<span class="dot">.</span></h1>
          <p class="hsub">Licence numérique, QR code, renouvellement en un clic, agenda et résultats de votre club — tout est dans l'app.</p>
          <div class="store">
            <span set:html={apple} /> <span class="stxt">App Store</span>
          </div>
        </div>
        <div class="phonewrap">
          <div class="phone"><div class="screen">
            <div class="notch"></div>
            <div class="app">
              <div class="appbar"><span class="ti">Ma licence</span><span class="bell"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#fff" stroke-width="2"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0"></path></svg></span></div>
              <div class="lic">
                <div class="lh"><span class="clg">JR</span><div><div class="cn">Judo Club Rennes</div><div class="cs">Saison 2025-26</div></div><span class="valid">● Valide</span></div>
                <div class="name">Camille Martin</div>
                <span class="sport">Judo · Ceinture marron</span>
                <svg class="qr" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                  <rect width="100" height="100" fill="#fff"></rect>
                  <g fill="#0D1E35">
                    <rect x="0" y="0" width="28" height="28"></rect><rect x="4" y="4" width="20" height="20" fill="#fff"></rect><rect x="8" y="8" width="12" height="12" fill="#0D1E35"></rect>
                    <rect x="72" y="0" width="28" height="28"></rect><rect x="76" y="4" width="20" height="20" fill="#fff"></rect><rect x="80" y="8" width="12" height="12" fill="#0D1E35"></rect>
                    <rect x="0" y="72" width="28" height="28"></rect><rect x="4" y="76" width="20" height="20" fill="#fff"></rect><rect x="8" y="80" width="12" height="12" fill="#0D1E35"></rect>
                    <rect x="36" y="4" width="4" height="4"></rect><rect x="44" y="4" width="4" height="4"></rect><rect x="52" y="8" width="4" height="4"></rect><rect x="60" y="4" width="4" height="4"></rect>
                    <rect x="36" y="12" width="4" height="4"></rect><rect x="48" y="12" width="4" height="4"></rect><rect x="60" y="12" width="4" height="4"></rect>
                    <rect x="4" y="36" width="4" height="4"></rect><rect x="12" y="36" width="4" height="4"></rect><rect x="20" y="40" width="4" height="4"></rect><rect x="4" y="44" width="4" height="4"></rect>
                    <rect x="36" y="36" width="4" height="4"></rect><rect x="44" y="40" width="4" height="4"></rect><rect x="52" y="36" width="4" height="4"></rect><rect x="60" y="44" width="4" height="4"></rect><rect x="40" y="48" width="4" height="4"></rect><rect x="56" y="52" width="4" height="4"></rect>
                    <rect x="72" y="36" width="4" height="4"></rect><rect x="80" y="40" width="4" height="4"></rect><rect x="88" y="36" width="4" height="4"></rect><rect x="76" y="48" width="4" height="4"></rect><rect x="92" y="44" width="4" height="4"></rect>
                    <rect x="36" y="60" width="4" height="4"></rect><rect x="44" y="60" width="4" height="4"></rect><rect x="52" y="64" width="4" height="4"></rect><rect x="60" y="60" width="4" height="4"></rect>
                    <rect x="36" y="72" width="4" height="4"></rect><rect x="44" y="76" width="4" height="4"></rect><rect x="52" y="80" width="4" height="4"></rect><rect x="60" y="84" width="4" height="4"></rect><rect x="40" y="88" width="4" height="4"></rect>
                    <rect x="72" y="72" width="4" height="4"></rect><rect x="80" y="76" width="4" height="4"></rect><rect x="88" y="80" width="4" height="4"></rect><rect x="76" y="88" width="4" height="4"></rect><rect x="92" y="72" width="4" height="4"></rect>
                  </g>
                </svg>
                <div class="no">N° 2025-FFJ-004821</div>
              </div>
            </div>
            <div class="tabbar">
              <div class="tab on"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 10h18"></path></svg>Licence</div>
              <div class="tab"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path></svg>Agenda</div>
              <div class="tab"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M10 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"></path></svg>Club</div>
              <div class="tab"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"></circle><path d="M4 21v-1a6 6 0 0 1 12 0v1"></path></svg>Profil</div>
            </div>
          </div></div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec light">
    <div class="container">
      <div class="eyebrow2 center">Votre sport, en un geste</div>
      <h2 class="center">Plus d'allers-retours ni de documents égarés.</h2>
      <p class="lead center mb">Tout ce dont vous avez besoin en tant que licencié, directement sur votre téléphone.</p>
      <div class="grid4">
        {benefices.map((b) => (<div class="bcard"><span class="ib" set:html={ckIcon(b.icon)} /><h3>{b.t}</h3><p>{b.d}</p></div>))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="container">
      <div class="eyebrow2 center">Dans l'application</div>
      <h2 class="center">Tout votre club, dans une app.</h2>
      <p class="lead center mb">Une expérience pensée pour les pratiquants et leurs familles.</p>
      <div class="grid3">
        {modules.map((m) => (<div class="mod"><span class="ib" set:html={ckIcon(m.icon)} /><h4>{m.t}</h4><p>{m.d}</p></div>))}
      </div>
    </div>
  </section>

  <section class="sec dark finalcta">
    <div class="container center">
      <h2>Votre licence vous attend dans l'app.</h2>
      <p class="lead center">Disponible sur iOS et Android — activée par votre club en un instant.</p>
      <div class="store center">
        <span set:html={apple} /> <span class="stxt">App Store</span>
        <span class="gp" set:html={gplay} /> <span class="stxt">Google Play</span>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .container { max-width: var(--maxw); margin: 0 auto; padding: 0 40px; }
  .sec { padding: 90px 0; }
  .dark { background: var(--navy); color: #fff; }
  .light { background: var(--cloud); }
  h2 { font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 42px; line-height: 1.07; letter-spacing: -.02em; margin: 0; }
  .eyebrow2 { font-weight: 600; font-size: 15.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--orange); margin-bottom: 14px; }
  .lead { font-size: 21px; line-height: 1.6; color: var(--muted); max-width: 640px; }
  .dark .lead { color: #aeb8c7; }
  .center { text-align: center; } .center.lead, .lead.center { margin-left: auto; margin-right: auto; }
  .mb { margin-bottom: 48px; }
  .ib { width: 48px; height: 48px; border-radius: 12px; background: var(--orange-soft); display: flex; align-items: center; justify-content: center; }

  .hero { position: relative; background: var(--navy); color: #fff; padding: 0 0 84px; overflow: hidden; }
  .hero::before { content: ""; position: absolute; inset: 0; background-image: radial-gradient(rgba(255,255,255,.05) 1px, transparent 1px); background-size: 24px 24px; opacity: .7; }
  .hero::after { content: ""; position: absolute; width: 760px; height: 760px; right: -160px; top: -260px; background: radial-gradient(circle, rgba(240,122,32,.2), transparent 62%); }
  .hero-body { position: relative; z-index: 1; padding-top: 40px; }
  .hgrid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 40px; align-items: center; }
  .crumb { font-size: 15.5px; color: #8595ac; margin-bottom: 16px; } .crumb b { color: #c7d2e0; }
  .eyebrow { font-weight: 600; font-size: 15.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--orange); margin-bottom: 14px; }
  h1 { font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 55px; line-height: 1.04; letter-spacing: -.02em; margin: 0 0 20px; }
  h1 .dot { color: var(--orange); }
  .hsub { font-size: 21px; line-height: 1.58; color: #aeb8c7; max-width: 520px; margin: 0 0 28px; }
  .store { display: flex; gap: 10px; align-items: center; }
  .store span { display: inline-flex; align-items: center; }
  .store .stxt { background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.16); border-radius: 11px; padding: 9px 15px 9px 10px; font-size: 15.5px; font-weight: 600; margin-left: -6px; margin-right: 8px; }

  /* phone */
  .phonewrap { display: flex; justify-content: center; }
  .phone { width: 300px; height: 604px; background: #080f1c; border-radius: 46px; padding: 12px; border: 1px solid rgba(255,255,255,.12); box-shadow: 0 50px 90px -20px rgba(0,0,0,.7); }
  .screen { position: relative; height: 100%; border-radius: 36px; overflow: hidden; background: linear-gradient(170deg, #16305a, #0d1e35 60%); }
  .notch { position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 120px; height: 26px; background: #080f1c; border-radius: 0 0 16px 16px; z-index: 3; }
  .app { padding: 40px 20px 0; color: #fff; }
  .appbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
  .appbar .ti { font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 21px; }
  .appbar .bell { width: 30px; height: 30px; border-radius: 9px; background: rgba(255,255,255,.1); display: flex; align-items: center; justify-content: center; }
  .lic { background: #fff; border-radius: 20px; padding: 18px; color: var(--navy); box-shadow: 0 20px 40px -16px rgba(0,0,0,.5); }
  .lic .lh { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
  .lic .clg { width: 32px; height: 32px; border-radius: 8px; background: var(--navy); color: #fff; display: flex; align-items: center; justify-content: center; font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 16px; }
  .lic .cn { font-weight: 700; font-size: 15.5px; } .lic .cs { font-size: 12px; color: var(--muted); }
  .lic .valid { margin-left: auto; font-size: 11px; font-weight: 700; color: var(--good); background: #e6f6ee; padding: 4px 9px; border-radius: 999px; }
  .lic .name { font-family: "Gabarito", sans-serif; font-weight: 800; font-size: 24px; line-height: 1.1; }
  .lic .sport { display: inline-block; font-size: 12.5px; font-weight: 600; color: var(--orange); background: var(--orange-soft); padding: 4px 10px; border-radius: 999px; margin: 8px 0 16px; }
  .qr { width: 130px; height: 130px; margin: 0 auto; display: block; }
  .lic .no { text-align: center; font-family: "JetBrains Mono", monospace; font-size: 12px; color: var(--muted); margin-top: 12px; letter-spacing: .04em; }
  .tabbar { position: absolute; bottom: 0; left: 0; right: 0; height: 64px; background: rgba(8,15,28,.9); border-top: 1px solid rgba(255,255,255,.08); display: flex; align-items: center; justify-content: space-around; padding-bottom: 8px; }
  .tab { display: flex; flex-direction: column; align-items: center; gap: 3px; font-size: 10.5px; color: #7c8aa3; font-weight: 600; }
  .tab.on { color: var(--orange); }

  .grid4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .bcard { background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 28px; }
  .bcard h3 { font-family: "Gabarito", sans-serif; font-weight: 700; font-size: 21px; margin: 16px 0 8px; }
  .bcard p { font-size: 17.5px; color: var(--muted); line-height: 1.5; }
  .mod { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 22px; }
  .mod h4 { font-family: "Gabarito", sans-serif; font-weight: 700; font-size: 19px; margin: 12px 0 5px; }
  .mod p { font-size: 16.5px; color: var(--muted); line-height: 1.45; }

  .finalcta { text-align: center; } .finalcta h2 { font-size: 46px; margin-bottom: 14px; }
  .finalcta .store { justify-content: center; margin-top: 26px; }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 960px) {
    .hgrid { grid-template-columns: 1fr; gap: 40px; }
    h1 { font-size: 46px; }
    .grid4 { grid-template-columns: repeat(2, 1fr); }
    .grid3 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 620px) {
    .container { padding: 0 20px; }
    .sec { padding: 56px 0; }
    .hero { padding-bottom: 56px; }
    h1 { font-size: 35px; }
    h2 { font-size: 28px; }
    .hsub, .lead { font-size: 21px; }
    .grid4, .grid3 { grid-template-columns: 1fr; }
    .finalcta h2 { font-size: 33px; }
  }
</style>
