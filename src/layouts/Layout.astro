---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Fedora — La plateforme des fédérations sportives",
  description = "Digitalisez, pilotez et développez votre fédération. Licences, affiliation, finances et espace club sur une seule plateforme souveraine.",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Gabarito:wght@400..800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    <!-- Applique le thème AVANT le premier rendu : sinon la page clignote
         en sombre pendant une frame avant de passer en clair. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("fedora-theme");
          if (!t) t = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", t);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
